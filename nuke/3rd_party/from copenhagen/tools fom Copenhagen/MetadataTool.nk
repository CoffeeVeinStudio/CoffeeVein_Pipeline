StickyNote {
 inputs 0
 name StickyNote27
 knobChanged "import metadata_tool; metadata_tool.update_metadata_tool_view()"
 tile_color 0x333933ff
 label "<font color='green'>First frame: 1001 / 1001</font>\n<font color='green'>Last frame: 1100 / 1100</font>\n<font color='gray'>Fps: None / 25</font>\n<font color='gray'>Width: None / 640</font>\n<font color='gray'>Height: None / 480</font>\n"
 note_font Verdana
 note_font_size 23
 selected true
 xpos 22246
 ypos 4126
 addUserKnob {20 User}
 addUserKnob {26 You_found_me l "" +STARTLINE +INVISIBLE T "<font style=\"font-size:80px; color: yellow;\">😃</font>"}
 addUserKnob {6 disable_callback l "disable updates" +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {26 info -STARTLINE T "This node are connected to a pythonscript named \"metadata_tool.py\". \n\nIt needs to be in the same backdrop as the ViewMetaData-node where we get our information from.\n\nYou can disable the updates to make the script slightly faster since it does not need to update every thime its selected."}
}
