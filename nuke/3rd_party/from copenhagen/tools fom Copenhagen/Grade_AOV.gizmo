set cut_paste_input [stack 0]
version 12.0 v4
push $cut_paste_input
Group {
name Grade_AOV
label "\[value in]"
selected true
xpos 13697
ypos 9266
addUserKnob {20 User}
addUserKnob {41 disable_1 l isolate_selected T isolate_selected.disable}
addUserKnob {41 in l AOV T global_AOV.in}
addUserKnob {26 ""}
addUserKnob {20 gaov l "Grade AOV" n 1}
addUserKnob {41 blackpoint T grade_AOV.blackpoint}
addUserKnob {41 whitepoint T grade_AOV.whitepoint}
addUserKnob {41 black l lift T grade_AOV.black}
addUserKnob {41 white l gain T grade_AOV.white}
addUserKnob {41 multiply T grade_AOV.multiply}
addUserKnob {41 add l offset T grade_AOV.add}
addUserKnob {41 gamma T grade_AOV.gamma}
addUserKnob {41 black_clamp l "black clamp" T grade_AOV.black_clamp}
addUserKnob {41 white_clamp l "white clamp" T grade_AOV.white_clamp}
addUserKnob {41 mix T grade_AOV.mix}
addUserKnob {20 endGroup n -1}
addUserKnob {20 expaov l "Exposure AOV" n 1}
addUserKnob {41 exposure l "Exposure +" T EXP.exposure}
addUserKnob {20 endGroup_2 l endGroup n -1}
addUserKnob {20 ccaov l "CC AOV" n 1}
addUserKnob {41 saturation T cc_AOV.saturation}
addUserKnob {41 contrast T cc_AOV.contrast}
addUserKnob {20 endGroup_1 l endGroup n -1}
addUserKnob {6 lut l Lut -STARTLINE}
addUserKnob {6 gizmo l Gizmo -STARTLINE}
}
