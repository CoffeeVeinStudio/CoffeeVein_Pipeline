 update_metadata_enable true
 addUserKnob {22 update_metadata l "Update Metadata Tool" -STARTLINE T "backdrop_nodes = \[]\n\nn = \"\"\nthis = nuke.thisNode()\n\nknob_values = \{\}\n\n# filter the String_Knob objects based on their names\nstring_knobs = \[knob for knob in this.knobs().values() if knob.Class() == \"EvalString_Knob\" and knob.name().startswith(\"key\")]\n\nfor knob in string_knobs:\n    knob_values\[knob.name()] = this\[knob.name()].value()\n\n    \n# Get stickyknob from Metedata backdrop\nfor node in nuke.allNodes(\"BackdropNode\"):\n    if \"Metadata\" in node\[\"label\"].value():\n        backdrop = node\n        for n in nuke.allNodes(\"StickyNote\"):\n            if n.knob('key_focal') and n != backdrop and backdrop.knob('xpos').value() < n.knob('xpos').value() < backdrop.knob('xpos').value() + backdrop.knob('bdwidth').value() and backdrop.knob('ypos').value() < n.knob('ypos').value() < backdrop.knob('ypos').value() + backdrop.knob('bdheight').value():\n                backdrop_nodes.append(n)\n\nif len(backdrop_nodes) == 0: \n                nuke.error(\"There are more than one metadataTool imported\")\n\nif len(backdrop_nodes) > 1:\n    nuke.message(\"More than one node found inside the backdrop node. Please only place one node stickynote with userknobs inside the metadata-backdrop.\")\nelif len(backdrop_nodes) == 0:\n    nuke.error(\"MetadataTool: Could not find the stickynote containing the userknobs inside a metadata-backdrop.\")\nelse:    \n    # Transfer the knob values to the target node\n    for knob, value in knob_values.items():\n        if knob in backdrop_nodes\[0].knobs():\n            backdrop_nodes\[0]\[knob].setValue(value)"}
