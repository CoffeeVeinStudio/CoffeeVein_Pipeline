 addUserKnob {22 set_current_write_colorspace l "Set to selected" -STARTLINE T "writeNode = nuke.selectedNode()\nif writeNode.Class() == \"Write\":\n    nuke.thisNode().knob(\"write_colorspace_string\").setValue(writeNode.knob(\"colorspace\").value())\nelse:\n    nuke.message(\"You need to select a Writenode\")"}
