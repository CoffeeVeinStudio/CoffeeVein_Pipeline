b_texture" "raw\tColorspaces/Utility/Aliases/raw" "look_aces10to01emulation\tColorspaces/Utility/Aliases/look_aces10to01emulation" "look_aces10to02emulation\tColorspaces/Utility/Aliases/look_aces10to02emulation" "look_aces10to07emulation\tColorspaces/Utility/Aliases/look_aces10to07emulation" "look_bluelightartifactfix\tColorspaces/Utility/Aliases/look_bluelightartifactfix" "role_reference\tColorspaces/Utility/Aliases/role_reference" "role_compositing_linear\tColorspaces/Utility/Aliases/role_compositing_linear" "role_compositing_log\tColorspaces/Utility/Aliases/role_compositing_log" "role_rendering\tColorspaces/Utility/Aliases/role_rendering" "role_scene_linear\tColorspaces/Utility/Aliases/role_scene_linear" "role_texture_paint\tColorspaces/Utility/Aliases/role_texture_paint" "role_default\tColorspaces/Utility/Aliases/role_default" "role_data\tColorspaces/Utility/Aliases/role_data" "role_matte_paint\tColorspaces/Utility/Aliases/role_matte_paint" "role_color_picking\tColorspaces/Utility/Aliases/role_color_picking" "role_color_timing\tColorspaces/Utility/Aliases/role_color_timing"}}
 preview_colorspaceOut "Output - sRGB"
 addUserKnob {7 preview_fps R 0 48}
 addUserKnob {4 preview_resize M {none width height fit fill distort ""}}
 preview_resize width
 addUserKnob {7 preview_aspect R 0.5 3}
 preview_aspect 1
 addUserKnob {20 endGroup_3 l endGroup n -1}
 addUserKnob {6 preview_borders +STARTLINE}
 addUserKnob {6 preview_addtimecode_node -STARTLINE}
 preview_addtimecode_node true
 addUserKnob {26 ""}
 addUserKnob {6 custom_viewerProcess_enabled l "" +STARTLINE +INVISIBLE +STARTLINE}
 addUserKnob {22 customviewer_process l "Custom viewer (ROW)" -STARTLINE +INVISIBLE T "\n\n#Set viewerProcess to plate\nfor node in nuke.allNodes(\"Dot\"):\n    if node\[\"label\"].getValue() == \"plate\":\n        for v_node in nuke.allNodes(\"Viewer\"):\n            v_node.setInput(0,node)\n        #Get info from input\n        topnode_name = nuke.tcl(\"full_name \[topnode %s]\" % node.name())\n        topnode = nuke.toNode(topnode_name)\n        #print(nuke.filename(topnode).split(\"/\")\[9] + \" (SHOT)\")\n        viewerProcessName = nuke.filename(topnode).split(\"/\")\[9] + \" (SHOT)\"\n        nuke.activeViewer().node()\['viewerProcess'].setValue(viewerProcessName)"}
}
