set cut_paste_input [stack 0]
version 14.0 v3
push $cut_paste_input
NoOp {
 name scriptHelper_v5_7_1
 note_font_size 31
 selected true
 xpos 561
 ypos 601
 hide_input true
 addUserKnob {20 main l Main}
 addUserKnob {6 scripthelper_check l "" +STARTLINE +INVISIBLE +STARTLINE}
 addUserKnob {6 import_enable l "" +STARTLINE +STARTLINE}
 import_enable true
 addUserKnob {22 importscriptHelper l "Import settings" t "Imports \"scriptHelper\" settings if it's been published at some point." -STARTLINE T "from os.path import exists\n\nif nuke.usingOcio():\n    settingsPath = paths.get_vfx_dir()+ \"_pipeline/nuke/scriptHelperSettings/aces_scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\nelse:\n    settingsPath = paths.get_vfx_dir()+ \"_pipeline/nuke/scriptHelperSettings/scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\n\nthis = nuke.thisNode()\nimported = None\n\n# Deselect all\nfor node in nuke.allNodes():\n    node.setSelected(False)\nthis.setSelected(True)\n\ntry:\n    if exists(settingsPath):\n\n        imported = nuke.nodePaste(settingsPath)\n        if this.knob(\"replace_this_node\").value() == True:\n            xPos = this\['xpos'].value()\n            yPos = this\['ypos'].value()\n            imported.setXYpos(xPos,yPos)\n\n        #-----------------------------------------------------------------------#\n        \n        #importing viewerProcess String\n        try:\n            importVp = imported\[\"viewerProcessString\"].getValue()\n            print (f\"Imported viewerProcessString\{importVp\}\")\n            this\[\"viewerProcessString\"].setValue(importVp)\n        except:\n            print (\"viewerProcessString knob did not work, skipping this knob\")\n            pass\n        \n        \n        #-----------------------------------------------------------------------#\n        \n        #importing custom viewer\n        try:\n            import_custom_viewerProcess_enabled = imported\[\"custom_viewerProcess_enabled\"].getValue()\n            print (\"Custom Viewer:  \", import_custom_viewerProcess_enabled)\n            this\[\"custom_viewerProcess_enabled\"].setValue(import_custom_viewerProcess_enabled)\n            # If enable custom viewer, we disable regular viewer process\n            if custom_viewerProcess_enabled.value() == True:\n                this\[\"viewerprocess_enable\"].setValue(False)\n        except:\n            print (\"Error when importing value from 'custom_viewerProcess_enabled', might be an old scriptHelper\")\n        \n        #-----------------------------------------------------------------------#\n        try:\n            importCs = (imported\[\"colorspaceString\"].getValue())\n            print (importCs)\n            this\[\"colorspaceString\"].setValue(importCs)\n        except:\n            print (\"Error when importing 'colorspaceString'\")\n        #-----------------------------------------------------------------------#\n        \n        #importing reference startframe\n        try:\n            import_ref_startframe = imported.knob(\"ref_startframe\").getValue()\n            print (\"Start frame:  \", import_ref_startframe)\n            this\[\"ref_startframe\"].setValue(import_ref_startframe)\n        except:\n            print (\"ref_startframe knob does not exist, please upgrade your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n        #importing reference startframe\n        try:\n            import_ref_ignore_mp4_boolean = imported.knob(\"ignore_mp4_boolean\").getValue()\n            print (\"Ignoring mp4 files:  \", import_ref_ignore_mp4_boolean)\n            this\[\"ignore_mp4_boolean\"].setValue(import_ref_ignore_mp4_boolean)\n        except:\n            print (\"ignore_mp4_boolean knob does not exist, please upgrade your scriptHelper\")\n            pass\n                    \n        \n        #-----------------------------------------------------------------------#\n        \n        #importing compression string\n        try:\n            importCompression = imported.knob(\"compression_string\").getValue()\n            print (importCompression + \"  compression\")\n            this\[\"compression_string\"].setValue(importCompression)\n        except:\n            print (\"Compression knob does not exist, please upgrade your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n        \n        #importing Write Metadata setting\n        try:\n            importMetaBoolean = imported.knob(\"all_metadata\").value()\n            print (\"Export all metadata?  \" + str(importMetaBoolean))\n            this\[\"all_metadata\"].setValue(importMetaBoolean)\n        except:\n            print (\"Metadata knob does not exist, please update your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n            \n        #importing custom_name\n        try:\n            import_cname_enableBoolean = imported.knob(\"cname_enable\").value()\n            this\[\"cname_enable\"].setValue(import_cname_enableBoolean)\n            \n            #import_proj_codeBoolean = imported.knob(\"proj_code\").value()\n            #this\[\"proj_code\"].setValue(import_proj_codeBoolean)\n            \n            import_custom_name = imported.knob(\"custom_name\").value()\n            print (\"Importing custom_name:  \" + str(import_custom_name))\n            this\[\"custom_name\"].setValue(import_custom_name)\n        except:\n            print (\"custom_name knob does not exist, please update your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n            \n        #Output colorspace\n        try:\n            import_write_colorspace = imported.knob(\"write_colorspace_string\").value()\n            this\[\"write_colorspace_string\"].setValue(import_write_colorspace)\n            if import_write_colorspace == \"\":\n                print (f\"Importedd 'write_colorspace_string' knob are empty, colorspace will be same as '_plate':  \{str(importCs)\}\")\n            print (f\"Importing write_colorspace_string:  \{str(import_write_colorspace)\}\")\n        except:\n            nuke.print(\"write_colorspace_string knob does not exist, please update your scriptHelper\")\n            pass\n        \n        \n        try:\n            import_version_digits = imported.knob(\"version_digits\").value()\n            this\[\"version_digits\"].setValue(import_version_digits)\n            print (\"Importing version_digits:  \" + str(import_version_digits))\n        except:\n            nuke.print(\"version_digits knob does not exist, please update your scriptHelper\")\n            pass\n            \n        try:\n            import_frame_digits = imported.knob(\"frame_digits\").value()\n            this\[\"frame_digits\"].setValue(import_frame_digits)\n            print (\"Importing frame_digits:  \" + str(import_frame_digits))\n        except:\n            nuke.print(\"frame_digits knob does not exist, please update your scriptHelper\")\n            pass        \n        #-----------------------------------------------------------------------#\n        \n        #Output comment string\n        try:\n            import_write_comment_string = imported.knob(\"write_comment_string\").value()\n            this\[\"write_comment_string\"].setValue(import_write_comment_string)\n            print (\"Importing write_colorspace_string:  \" + str(import_write_comment_string))\n        except:\n            nuke.print(\"write_comment_string knob does not exist, please update your scriptHelper\")\n            pass\n\n        # preview settings\n\n        previewKnobs = \[\n        \"project_name\",\n        \"preview_codec\",\n        \"preview_slate\",\n        \"preview_format\",\n        \"LUT_colorspaceIn\",\n        \"LUT_colorspaceOut\",\n        \"preview_colorspaceOut\",\n        \"preview_fps\",\n        \"preview_resize\",\n        \"preview_aspect\",\n        \"preview_borders\",\n        \"preview_addtimecode_node\"\n        ]\n        \n        \n        \n        for knob in previewKnobs:\n            try:\n                this\[knob].setValue(imported.knob(knob).value())\n            except:\n                print(f\"Error: Could not get value for the \{knob\} knob.\")\n        #-----------------------------------------------------------------------#\n        \n        try:\n            import_convert_version_enable = imported.knob(\"convert_version_enable\").value()\n            this\[\"convert_version_enable\"].setValue(import_convert_version_enable)\n            print (\"Converting number of versions digits to 4?  \" + str(import_convert_version_enable))\n        except:\n            nuke.print(\"convert_version knob does not exist, might need to create a new scriptHelper node, transfer the settings and publish\")\n            pass\n        \n        #Output metadata keys\n        try:\n            imported_knob_values = \{\}\n            \n            # filter the String_Knob objects based on their names\n            imported_string_knobs = \[knob for knob in imported.knobs().values() if knob.Class() == \"EvalString_Knob\" and knob.name().startswith(\"key\")]\n            \n            for knob in imported_string_knobs:\n                imported_knob_values\[knob.name()] = imported\[knob.name()].value()\n            \n            # Transfer the knob values to the target node\n            try:\n                for knob, value in imported_knob_values.items():\n                    if knob in this.knobs():\n                        this\[knob].setValue(value)\n            except:\n                nuke.error(\"Could not copy over metadata knobs values\")\n                pass\n          \n        except:\n            print (\"Error: something happend when transferring the metadata keys values\")\n            \n        #-----------------------------------------------------------------------#\n            \n        \n    else:\n        ask = nuke.ask(\"Unable to find a scriptHelper in\" + settingsPath + \", would you like to create one?\")\n        if ask:\n            this\[\"publishScript\"].execute()\n            nuke.message(\"I have published a script as:  \" + settingsPath )\nexcept:\n    pass\n    \ntry:\n    #Deleting imported node, goodbye\n    if this.knob(\"replace_this_node\").value() == True:\n        nuke.delete(this)\n    else:\n        if imported != None:\n            nuke.delete(imported)\n            print(\"Deleted imported scriptHelperSettings node\")\n        pass\nexcept:\n    print(\"There's no imported node to delete\")"}
 addUserKnob {22 publishScript l "Publish settings" t "Only do this if you know that you have the correct settings." -STARTLINE T "# import modules\nimport shutil\nfrom os.path import exists\nimport os\nimport sys\nfrom datetime import datetime\n\n# Get time \nnow = datetime.now() # current date and time\nnow_format = now.strftime(\"%Y%m%d_%H%M%S\") #This gives YYYYMMDD_HHMMSS in string format. fx. 20221018_092433 \n\n\n\n# Define folders\nget_scripthelp_folder = paths.get_vfx_dir() + \"_pipeline/nuke/scriptHelperSettings/\"\n\n# if ACES\nif nuke.usingOcio():\n    settings_path = get_scripthelp_folder + \"aces_scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\nelse:\n    settings_path = get_scripthelp_folder + \"scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\n    \nbackup_path = get_scripthelp_folder + \"backup/\"\n\nbackup_filepath = backup_path + now_format + \"_scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\n\n\nif not exists(get_scripthelp_folder):\n    os.makedirs(get_scripthelp_folder)\n\n\nif not exists(backup_path):\n    os.makedirs(backup_path)\n\n\ntry:\n    # Ask if settingsfile exist and ask permission\n    if exists(settings_path):\n        #Raise flag\n        ask = nuke.ask(\"Warning!  \" + settings_path + \"  already exists, would you like to replace it?\")\n        if ask:\n            # Backup file\n            src_dir = settings_path\n            dst_dir = backup_filepath\n            shutil.copy2(src_dir, dst_dir)\n            \n            \n            for node in nuke.allNodes():\n                node.setSelected(False)\n            nuke.thisNode().setSelected(True)\n            nuke.nodeCopy(settings_path)\n            print (\"Yes\")\n        else:\n            # You are not allowed to write over, exiting.\n            sys.exit()\n            \n# Redundant code?\nexcept:\n    pass\n\n\n# Only select the settings script and copy it to the settings-folder\ntry:\n    for node in nuke.selectedNodes():\n        node.setSelected(False)\n    nuke.thisNode().setSelected(True)\n    nuke.nodeCopy(settings_path)\n\nexcept:\n    nuke.message(\"Unable to publish settings\")\n"}
 addUserKnob {6 replace_this_node l "Replace with scriptHelper node" -STARTLINE +INVISIBLE}
 addUserKnob {22 replace_scripthelper_node l "Replace scriptHelper node with project scriptHelper" -STARTLINE T "from os.path import exists\n\n\nif nuke.usingOcio():\n    settingsPath = paths.get_vfx_dir()+ \"_pipeline/nuke/scriptHelperSettings/aces_scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\nelse:\n    settingsPath = paths.get_vfx_dir()+ \"_pipeline/nuke/scriptHelperSettings/scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\n\nthis = nuke.thisNode()\nxPos = this\['xpos'].value()\nyPos = this\['ypos'].value()\nimported = None\n\n# Deselect all\nfor node in nuke.allNodes():\n    node.setSelected(False)\nthis.setSelected(True)\n\ntry:\n    if exists(settingsPath):\n        imported = nuke.nodePaste(settingsPath)\n        #if this.knob(\"replace_this_node\").value() == True:\n            \n        nuke.delete(this)\nexcept:\n    print(\"Something went wrong\")\n    \nimported.setXYpos(int(xPos),int(yPos))"}
 addUserKnob {26 ""}
 addUserKnob {6 createScriptSetup_enable l "" +STARTLINE +STARTLINE}
 createScriptSetup_enable true
 addUserKnob {22 createScriptSetup l "Create scriptSetup" -STARTLINE T "def scanNodesScriptSetup():\n    for node in nuke.allNodes(\"BackdropNode\"):\n        if node.knob(\"scriptSetupCheck\"):\n            return False\n    return True\n            \nif scanNodesScriptSetup():\n\n    for node in nuke.selectedNodes():\n        node.setSelected(False)\n            \n    nuke.nodePaste(\"//fs/data/_pipeline/_bin/nuke/_tools/studio/tools/scriptSetup.nk\")\n    for node in nuke.selectedNodes():\n        node.setSelected(False)\n    \n    \n\nfor node in nuke.allNodes(\"Group\"):\n    node.setSelected(True)\n    nuke.autoplace_all()\n    node.setSelected(False)           \n     \nif not scanNodesScriptSetup():\n    for node in nuke.allNodes(\"BackdropNode\"):\n        if node.knob(\"scripsetupBackdrop\"):\n            #for node in nuke.allNodes(\"BackdropNode\"):\n            xPos = int(node.xpos()+ 100)\n            yPos = int(node.ypos()+ 100)\n            print (xPos)\n            print (yPos)\n            nuke.zoom(.4,\[xPos,yPos])\n\n            nuke.thisNode().setXYpos(xPos,yPos)\n                \n    #Remove connected ( deselecting all so might be redundant)\n    #if nuke.selectedNode().dependent():\n    #    nodes = nuke.selectedNode().dependent()\n    #    for i in nodes: \n    #        for j in range(i.inputs()): i.setInput(j, None) )\n    \n"}
 addUserKnob {26 ""}
 addUserKnob {6 getPlate_enable l "" t "disable to bypass" +STARTLINE +STARTLINE}
 getPlate_enable true
 addUserKnob {22 getPlate l "Import Plates" t "Looking in \"_plate\" and importing as readnodes." -STARTLINE T "import paths\nimport os\nimport re\n\nthis = nuke.thisNode()\n\n    \ndef get_all_directories(path):\n    \n    folders = \[path]\n    slashconvert_folders = \[]\n    \n    for dirpath, dirnames, filenames in os.walk(path):\n        for dirname in dirnames:  \n            folders.append(os.path.join(dirpath, dirname))\n     \n    for dir in folders:\n        slashconvert_folders.append(paths.slashconvert(dir))\n    \n    version_pattern = re.compile(r\"/v\\d+\$\")\n    version_folders = \[folder for folder in slashconvert_folders if version_pattern.search(folder)]\n    sorted_folders = sorted(version_folders, key=lambda x: int(x.split(\"/\")\[-1]\[1:]))\n    \n    latest_version = \"\"\n    latest_folders = \[]\n    \n    #reverse sorted\n    #sorted_folders = sorted(sorted_folders, reverse=True)\n\n    for folder in sorted(sorted_folders, reverse=True):\n        version = folder.split(\"/\")\[-1]\[1:]\n        if version > latest_version:\n            latest_version = version\n            latest_folders.append(folder)\n\n     \n    all_folders = list(set(slashconvert_folders) - set(version_folders)) + latest_folders\n    \n    return all_folders\n\n\ndef create_plate_readnodes(label, xPos, yPos, first,dot_node):\n    # create paths\n\n    # get all folders\n    for folder in get_all_directories(paths.get_plate_renders_dir()):\n        #folder = paths.slashconvert(folder)\n        print (\"create readnode:  \" + folder)\n        # Get items in folders\n        for item in nuke.getFileNameList(folder):\n            if \".\" in str(item):\n                try:\n                    label = folder.split(\"_plates/\")\[-1].replace(\"/\", \"_\")\n                    #print (label)\n                    fullplatename = folder + \"/\" + item\n                    \n                    # Creating new readnodes\n                    newread = nuke.createNode(\"Read\", inpanel = False)\n                    newread\[\"file\"].fromUserText(fullplatename)\n                    \n                    \n                    # Connecting the first detected plate into the Plate01 input,\n                    \n                    if first:\n                        dot_node.setInput(0, newread)\n                        first = False\n                        yPos -= 110\n                        newread.setXYpos(xPos - 34, yPos)\n                        \n                    # Other plates will be located next to it.\n                    else:\n                        xPos += 175\n                        newread.setXYpos(xPos, yPos)\n\n                    newread.knob(\"label\").setValue(label)\n                    \n                    newread.setSelected(False)\n                    \n                    \n                except:\n                    print(\"Resulted in an error:  \" + str(item))\n\n\n\n#######     Main     ##########\ndef get_plate_main():\n\n    for node in nuke.allNodes():\n        node.setSelected(False)\n    \n    plate_dot_exist = False\n    \n    for dot_node in nuke.allNodes(\"Dot\"):\n        if dot_node\[\"label\"].getValue() == \"plate\":\n            plate_dot_exist = True\n            xPos = dot_node.xpos()\n            yPos = dot_node.ypos()\n            label = \"\"\n            first = True\n            #node.setSelected(True)\n            create_plate_readnodes(label, xPos, yPos, first,dot_node)\n\n            \n    if not plate_dot_exist:\n            xPos = this.xpos()\n            yPos = this.ypos()\n            label = \"\"\n            first = False\n            #this.setSelected(True)\n            dot_node = None\n            create_plate_readnodes(label, xPos, yPos, first,dot_node)\n#try:\n#    get_plate_main()\n#except:\n#    print(\"Error when importing plates.\")\n\nget_plate_main()"}
 addUserKnob {6 getRef_enable l "" +STARTLINE +STARTLINE}
 getRef_enable true
 addUserKnob {22 getRef l "Import Reference" t "Looking in \"_references\" and importing as readnodes." -STARTLINE T "\n\n\"\"\"\nfor node in nuke.allNodes():\n    if node.Class() == \"Dot\":\n        if node\[\"label\"].getValue() == \"offline\":\n            node.setSelected(True)\n            xPos = node.xpos()\n            yPos = node.ypos()\n\n            #Create readnodes\n            refdir = paths.get_vfx_dir() + paths.get_sequence()+ '/' + paths.get_shot() + '/_references/'\n\n            refdirList = nuke.getFileNameList(refdir)#\[0]\n            for refname in refdirList:\n                \n                if refname.endswith(\".gif\"):\n                    refdirList.remove(refname)\n            \n            for refname in refdirList:                \n                fullrefname = refdir + refname\n\n    \n                newread = nuke.createNode(\"Read\", inpanel = False)\n                newread\[\"file\"].fromUserText(fullrefname)\n                newread\[\"before\"].setValue(\"black\")\n                newread\[\"after\"].setValue(\"black\")\n                \n                newread.setXYpos(xPos - 34, yPos - 110 )\n                #Colorspace according to ocio settings\n                if \"aces\" in ocio_config:\n                    newread\[\"colorspace\"].setValue(\"Output - Rec.709\")\n                else:\n                    newread\[\"colorspace\"].setValue(\"rec709\")\n    \n                if refname == refdirList\[0]:\n                    node.setInput(0,newread)\n                    # Get startframe\n\n                else:\n                    xPos += 100\n                    newread.setXYpos(xPos, yPos - 110)\n            node.setSelected(False)\n            \n            \"\"\"\n\n\nimport paths\nimport os\nimport re\n\n\n\n    \ndef get_all_directories(path):\n    \n    folders = \[path]\n    slashconvert_folders = \[]\n    \n    for dirpath, dirnames, filenames in os.walk(path):\n        for dirname in dirnames:  \n            folders.append(os.path.join(dirpath, dirname))\n     \n    for dir in folders:\n        slashconvert_folders.append(paths.slashconvert(dir))\n    \n    version_pattern = re.compile(r\"/v\\d+\$\")\n    version_folders = \[folder for folder in slashconvert_folders if version_pattern.search(folder)]\n    sorted_folders = sorted(version_folders, key=lambda x: int(x.split(\"/\")\[-1]\[1:]))\n    \n    latest_version = \"\"\n    latest_folders = \[]\n    \n    #reverse sorted\n    #sorted_folders = sorted(sorted_folders, reverse=True)\n\n    for folder in sorted(sorted_folders, reverse=True):\n        version = folder.split(\"/\")\[-1]\[1:]\n        if version > latest_version:\n            latest_version = version\n            latest_folders.append(folder)\n\n     \n    all_folders = list(set(slashconvert_folders) - set(version_folders)) + latest_folders\n    \n    return all_folders\n\ndef import_mp4_check(item):\n    \n    if item.endswith(\".mp4\") == True:\n        if nuke.thisNode().knob(\"ignore_mp4_boolean\").getValue() == True:\n            return False\n        else:\n            return True\n    else:\n        return True\n    \ndef create_ref_readnodes(label, xPos, yPos, first):\n    # create paths\n    refpath = paths.get_vfx_dir() + paths.get_sequence()+ '/' + paths.get_shot() + '/_references/'\n    # get all folders\n    for folder in get_all_directories(refpath):\n        #folder = paths.slashconvert(folder)\n        print (\"create reference readnode:  \" + folder)\n        # Get items in folders\n        for item in nuke.getFileNameList(folder):\n            if \".\" in item:\n                if item.endswith(\".gif\") == False and item.endswith(\".aaf\") == False:\n                    # Check if we want to import mp4 files or not.\n                    if import_mp4_check(item):\n                        \n                        label = folder.split(\"_references/\")\[-1].replace(\"/\", \"_\")\n                        #print (label)\n                        \n                        # Set fullplatename and make sure we dont get \"reference//\"\n                        if folder == refpath:\n                            fullplatename = folder + item\n                        else:\n                            fullplatename = folder + \"/\" + item\n                        \n                        # Creating new readnodes\n                        newread = nuke.createNode(\"Read\", inpanel = False)\n                        newread\[\"file\"].fromUserText(fullplatename)\n                        \n                        #Colorspace according to ocio settings\n                        if \"aces\" in ocio_config:\n                            newread\[\"colorspace\"].setValue(\"Output - Rec.709\")\n                        else:\n                            newread\[\"colorspace\"].setValue(\"rec709\")\n                        # Connecting the first detected plate into the Plate01 input,\n                        \n                        if first:\n                            node.setInput(0, newread)\n                            print(\"First is:  \" + str(first))\n                            first = False\n                            yPos -= 110\n                            newread.setXYpos(xPos - 34, yPos)\n                            \n                        # Other plates will be located next to it.\n                        else:\n                            xPos += 175\n                            newread.setXYpos(xPos, yPos)\n                \n                        newread.knob(\"label\").setValue(label)\n                    \n                        newread.setSelected(False)\n            \"\"\"\n            try:                    \n            except:\n                print(\"Resulted in an error:  \" + str(item))\n            \"\"\"\n\n\n\n#######     Main     ##########\n\nthis = nuke.thisNode()\n\nocio_config = nuke.Root()\[\"OCIO_config\"].value()\n\n# Deselect allNodes\nfor node in nuke.allNodes():\n    node.setSelected(False)\n\n\nref_dot_exist = False\n\nfor node in nuke.allNodes(\"Dot\"):\n    if node\[\"label\"].getValue() == \"offline\":\n        ref_dot_exist = True\n        xPos = node.xpos()\n        yPos = node.ypos()\n        label = \"\"\n        first = True\n        node.setSelected(True)\n        create_ref_readnodes(label, xPos, yPos, first)\n        \nif not ref_dot_exist:\n        node = this\n        xPos = node.xpos()\n        yPos = node.ypos()\n        label = \"\"\n        first = False\n        node.setSelected(True)\n        create_ref_readnodes(label, xPos, yPos, first)\n        \n\n#Change startnode\n\nif nuke.thisNode()\[\"startframe_enable\"]:\n\n    ref_startframe = nuke.thisNode()\[\"ref_startframe\"].value()\n    for g_node in nuke.allNodes(\"Group\"):# temp fix, would like to only change connected nodes.\n        if \"TimecodeCalc\" in g_node.name():\n            g_node.knob(\"startframe\").setValue(ref_startframe)\n\n    #depNode = node.dependent()\[0]\n    #if \"TimecodeCalc\" in depNode.name():\n        #depNode.knob(\"startframe\").setValue(ref_startframe)\nelse:\n    print (\"Did not update startframe of reference, since it's disabled\")\n    pass\n\n"}
 addUserKnob {6 startframe_enable l "" -STARTLINE}
 startframe_enable true
 addUserKnob {3 ref_startframe l "Start frame" t "set the standard startframe of the ref" -STARTLINE}
 ref_startframe 1001
 addUserKnob {6 ignore_mp4_boolean l "ignore mp4?" -STARTLINE}
 addUserKnob {22 test l "transcode ref panel" -STARTLINE +INVISIBLE T "import os\nimport subprocess\nimport tkinter as tk\nfrom tkinter import filedialog, messagebox, Menu\nfrom tkinter import ttk\nfrom tkinterdnd2 import DND_FILES, TkinterDnD\n\n\nclass VideoTranscoderApp:\n    def __init__(self, root, ffmpeg_path, ffprobe_path):\n        self.root = root\n        self.root.title(\"Video to Jpeg Transcoder\")\n        \n        self.ffmpeg_path = ffmpeg_path\n    \n        self.ffprobe_path = ffprobe_path\n\n\n\n        self.context_menu = Menu(root, tearoff=0)\n        self.context_menu.add_command(label=\"Open File Location\", command=self.open_file_location)\n\n\n        self.frame = tk.Frame(root)\n        self.frame.pack(padx=10, pady=10)\n        \n        self.buttons_frame = tk.Frame(self.frame)\n        self.buttons_frame.pack(side=tk.TOP)\n        \n        self.add_button = tk.Button(self.buttons_frame, text=\"Add Files\", command=self.add_files)\n        self.add_button.pack(side=tk.LEFT)\n        \n        self.load_sequence_button = tk.Button(self.buttons_frame, text=\"Load in sequence _references\", command=self.load_sequence)\n        self.load_sequence_button.pack(side=tk.LEFT)\n        \n        self.transcode_button = tk.Button(self.buttons_frame, text=\"Transcode\", command=self.transcode_selected)\n        self.transcode_button.pack(side=tk.LEFT)\n        \n        self.transcode_all_button = tk.Button(self.buttons_frame, text=\"Transcode All\", command=self.transcode_all)\n        self.transcode_all_button.pack(side=tk.LEFT)\n        \n        self.remove_button = tk.Button(self.buttons_frame, text=\"Remove Selected\", command=self.remove_selected)\n        self.remove_button.pack(side=tk.LEFT)\n        \n        self.file_list_label = tk.Label(self.frame, text=\"Input files\")\n        self.file_list_label.pack()\n        \n        self.file_list = tk.Listbox(self.frame, selectmode=tk.MULTIPLE, width=126, height=20)\n        self.file_list.pack(fill=tk.BOTH, expand=True)\n        self.file_list.bind(\"<Button-3>\", self.show_context_menu)\n\n\n        self.completed_list_label = tk.Label(self.frame, text=\"Completed\")\n        self.completed_list_label.pack()\n        \n        self.completed_list = tk.Listbox(self.frame, width=126, height=20)\n        self.completed_list.pack(fill=tk.BOTH, expand=True)\n        self.completed_list.bind(\"<Button-3>\", self.show_context_menu)\n        \n        self.progress_label = tk.Label(self.frame, text=\"Progress: 0/0\")\n        self.progress_label.pack()\n        \n        self.quit_button = tk.Button(self.frame, text=\"Quit\", command=root.quit)\n        self.quit_button.pack(side=tk.LEFT, anchor=tk.SW, padx=10, pady=10)  # Placed at bottom-left corner\n        \n        self.root.geometry(\"800x800\")  # Adjust window size as needed\n        \n        \n        \n\n\n\n\n        # Enable drag-and-drop\n        self.file_list.drop_target_register(DND_FILES)\n        self.file_list.dnd_bind('<<Drop>>', self.handle_drop)\n        \n        self.total_files = 0\n        self.completed_files = 0\n        \n        self.transcoding_popup = None\n        self.transcoding_process = None\n        self.transcoding_cancelled = False\n\n\n    def show_context_menu(self, event):\n        self.context_menu.post(event.x_root, event.y_root)\n        self.current_listbox = event.widget\n        self.current_selection = self.current_listbox.nearest(event.y)\n\n\n    def open_file_location(self):\n        if self.current_listbox and self.current_selection >= 0:\n            selected_file = self.current_listbox.get(self.current_selection)\n            if selected_file:\n                #file_folder = os.path.dirname(selected_file)\n                subprocess.Popen(\[\"explorer\", \"/select,\", os.path.normpath(selected_file)])\n    \n\n\n\n        \n\n\n    def add_files(self):\n        files = filedialog.askopenfilenames(filetypes=\[\n            (\"Video Files\", \"*.mp4 *.avi *.mov\"),\n            (\"All Files\", \"*.*\")\n        ])\n        for file in files:\n            self.file_list.insert(tk.END, file)\n            self.total_files += 1\n            self.update_progress_label()\n\n\n        \n    def load_sequence(self):\n        seq_folder = filedialog.askdirectory(title=\"Select Sequence Folder\")\n        if not seq_folder:\n            return\n        \n        for root, dirs, _ in os.walk(seq_folder):\n            for dir_name in dirs:\n                ref_folder = os.path.join(root, dir_name, \"_references\")\n                if os.path.exists(ref_folder):\n                    mp4_files = \[file for file in os.listdir(ref_folder) if file.lower().endswith(\".mp4\")]\n                    for mp4_file in mp4_files:\n                        input_file = os.path.join(ref_folder, mp4_file)\n                        self.file_list.insert(tk.END, input_file)\n                        self.total_files += 1\n                        self.update_progress_label()\n        \n    def transcode_selected(self):\n        selected_files = self.file_list.curselection()\n        if not selected_files:\n            messagebox.showinfo(\"Error\", \"Please select at least one file.\")\n            return\n        \n        self.transcoding_popup = tk.Toplevel(self.root)\n        self.transcoding_popup.title(\"Transcoding Progress\")\n        self.transcoding_popup.geometry(\"300x100\")\n        \n        self.progress_label_popup = tk.Label(self.transcoding_popup, text=\"Progress: 0/0\")\n        self.progress_label_popup.pack(pady=10)\n        \n        self.progress_bar = ttk.Progressbar(self.transcoding_popup, orient=\"horizontal\", length=200, mode=\"determinate\")\n        self.progress_bar.pack()\n        \n        self.cancel_button = tk.Button(self.transcoding_popup, text=\"Cancel\", command=self.cancel_transcoding)\n        self.cancel_button.pack(pady=10)\n        \n        self.transcoding_popup.transient(self.root)\n        self.transcoding_popup.grab_set()\n        \n        for idx in selected_files:\n            if self.transcoding_cancelled:\n                break\n            file = self.file_list.get(idx)\n            if self.is_long_file(file):\n                if not self.confirm_long_file(file):\n                    continue\n            self.transcode_to_jpeg(file)\n            self.completed_list.insert(tk.END, file)\n            self.file_list.delete(idx)\n            self.completed_files += 1\n            self.update_progress_label_popup()\n        \n        self.transcoding_popup.destroy()\n        self.update_progress_label()\n        messagebox.showinfo(\"Finished\", \"Transcoding complete.\")\n        \n    def transcode_all(self):\n        files = list(self.file_list.get(0, tk.END))\n        \n        self.transcoding_popup = tk.Toplevel(self.root)\n        self.transcoding_popup.title(\"Transcoding Progress\")\n        self.transcoding_popup.geometry(\"300x100\")\n        \n        self.progress_label_popup = tk.Label(self.transcoding_popup, text=\"Progress: 0/0\")\n        self.progress_label_popup.pack(pady=10)\n        \n        self.progress_bar = ttk.Progressbar(self.transcoding_popup, orient=\"horizontal\", length=200, mode=\"determinate\")\n        self.progress_bar.pack()\n        \n        self.cancel_button = tk.Button(self.transcoding_popup, text=\"Cancel\", command=self.cancel_transcoding)\n        self.cancel_button.pack(pady=10)\n        \n        self.transcoding_popup.transient(self.root)\n        self.transcoding_popup.grab_set()\n        \n        for file in files:\n            if self.transcoding_cancelled:\n                break\n            if self.is_long_file(file):\n                if not self.confirm_long_file(file):\n                    continue\n            self.transcode_to_jpeg(file)\n            self.completed_list.insert(tk.END, file)\n            self.completed_files += 1\n            self.update_progress_label_popup()\n        \n        self.transcoding_popup.destroy()\n        self.file_list.delete(0, tk.END)\n        self.update_progress_label()\n        messagebox.showinfo(\"Finished\", \"Transcoding all files complete.\")\n        \n    def transcode_to_jpeg(self, input_file):\n        try:\n            base_name = os.path.splitext(os.path.basename(input_file))\[0]\n            input_folder = os.path.dirname(input_file)\n            output_folder = os.path.join(input_folder, f\"\{base_name\}_jpeg\")\n            \n            if not os.path.exists(output_folder):\n                os.makedirs(output_folder)\n            \n            output_pattern = os.path.join(output_folder, f\"\{base_name\}.%04d.jpeg\")\n            \n            ffmpeg_command = \[\n                self.ffmpeg_path,\n                \"-i\", input_file,\n                \"-q:v\", \"2\",\n                \"-y\",\n                output_pattern\n            ]\n            \n            self.transcoding_process = subprocess.Popen(ffmpeg_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n            self.transcoding_process.communicate()\n            self.transcoding_process.wait()\n            \n        except subprocess.CalledProcessError as e:\n            print(f\"Error transcoding \{input_file\}: \{e.stderr.decode('utf-8').strip()\}\")\n            \n    def is_long_file(self, input_file):\n        try:\n            ffprobe_command = \[\n                self.ffprobe_path,\n                \"-v\", \"error\",\n                \"-i\", input_file,\n                \"-count_frames\",\n                \"-select_streams\", \"v:0\",\n                \"-show_entries\", \"stream=nb_read_frames\",\n                \"-print_format\", \"default=noprint_wrappers=1:nokey=1\"\n            ]\n\n\n            process = subprocess.Popen(ffprobe_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n            out, err = process.communicate()\n\n\n            if err:\n                print(f\"Error getting frame count for \{input_file\}: \{err.decode('utf-8').strip()\}\")\n                return False\n\n\n            frame_count = int(out.decode('utf-8'))\n            return frame_count > 1500\n        \n        except subprocess.CalledProcessError as e:\n            print(f\"Error getting frame count for \{input_file\}: \{e.stderr.decode('utf-8').strip()\}\")\n            return False\n        \n    def confirm_long_file(self, input_file):\n        return messagebox.askyesno(\"Confirm\", f\"\{input_file\} has more than 1500 frames. Are you sure you want to proceed?\")\n    \n    def handle_drop(self, event):\n        files = event.data\n        for file in files:\n            if file.lower().endswith(\".mp4\"):\n                self.file_list.insert(tk.END, file)\n                self.total_files += 1\n                self.update_progress_label()\n        \n    def remove_selected(self):\n        selected_files = self.file_list.curselection()\n        for idx in reversed(selected_files):\n            self.file_list.delete(idx)\n            self.total_files -= 1\n            if idx < self.completed_files:\n                self.completed_files -= 1\n        self.update_progress_label()\n        \n    def cancel_transcoding(self):\n        if self.transcoding_process is not None:\n            self.transcoding_process.terminate()\n        self.transcoding_cancelled = True\n        \n    def update_progress_label(self):\n        progress_text = f\"Progress: \{self.completed_files\}/\{self.total_files\}\"\n        self.progress_label.config(text=progress_text)\n        \n    def update_progress_label_popup(self):\n        progress_text = f\"Progress: \{self.completed_files\}/\{self.total_files\}\"\n        self.progress_label_popup.config(text=progress_text)\n        progress_percentage = (self.completed_files / self.total_files) * 100\n        self.progress_bar\[\"value\"] = progress_percentage\n        self.transcoding_popup.update()\n\n\ndef main():\n    root = TkinterDnD.Tk()\n    ffmpeg_path = '//fs/data/_pipeline/_bin/ffmpeg/4.2.0/ffmpeg.exe'\n    ffprobe_path = '//fs/data/_pipeline/_bin/ffmpeg/4.2.0/ffprobe.exe'\n    app = VideoTranscoderApp(root, ffmpeg_path, ffprobe_path)\n    root.mainloop()\n\n\n\nmain()\n\n\n\n\n"}
 addUserKnob {26 ""}
 addUserKnob {6 viewerprocess_enable l "" t "disable to bypass" +STARTLINE +STARTLINE}
 viewerprocess_enable true
 addUserKnob {22 viewerprocess l "Set viewerProcess" t "Pressing will change viewerProcess on all viewers in your script" -STARTLINE T "this = nuke.thisNode()\nviewer_process_string = this\[\"viewerProcessString\"].getValue()\n\nall_viewer_nodes = nuke.allNodes(\"Viewer\")\n\nif not len(all_viewer_nodes)> 0:\n    #this = nuke.selectedNode() #for testing\n    viewer = nuke.createNode(\"Viewer\")\n    viewer.knob(\"label\").setValue(\"\[value viewerProcess]\")\n    viewer.setInput(0,this)\n    viewer.hideControlPanel()\n\n\nif viewer_process_string != \"\":\n\n    for node in nuke.allNodes(\"Viewer\"):\n        try:\n            node\[\"viewerProcess\"].setValue(viewer_process_string)\n        except:\n            print(f\"Error when updating viewer node \{node.name()\}, since 'viewer_process_string' are empty\")\n            pass\nelse:\n    print(\"ERROR: 'viewerProcessString' knob are empty, Could not update the Viewer nodes\")"}
 addUserKnob {1 viewerProcessString l "" -STARTLINE}
 addUserKnob {22 setCurrentViewerProcess l "Set current" t "Get current viewer input process and replace the string" -STARTLINE T "try:\n    currentViewerProcess = nuke.activeViewer().node().knob(\"viewerProcess\").value()\n    nuke.thisNode().knob(\"viewerProcessString\").setValue(currentViewerProcess)\nexcept:\n    pass\n\n"}
 addUserKnob {6 plateColorspace_enable l "" t "disable to bypass" +STARTLINE +STARTLINE}
 plateColorspace_enable true
 addUserKnob {22 plateColorspace l "Set _plate colorspace" t "plate needs to be in \"_plate\"" -STARTLINE T "colorspace_string = nuke.thisNode().knob(\"colorspaceString\").getValue()\n\ntry:\n    for node in nuke.allNodes(\"Read\"):\n        node_name = node.name()\n        if \"/_plates/\" in node\[\"file\"].getValue():\n            print(f\"Updating colorspace in the readnode:\{node_name\} to:\{colorspace_string\} \")\n            node\[\"colorspace\"].setValue(colorspace_string)\nexcept:\n    pass"}
 addUserKnob {1 colorspaceString l "" -STARTLINE}
 addUserKnob {22 setCurrentPlateColorspace l "Set current" t "Get current input to the \"plate\" dot replacing the \"colorspaceString\"." -STARTLINE T "for node in nuke.allNodes(\"Dot\"):\n    if node\[\"label\"].getValue() == \"plate\":\n        try:\n            inputColorspace = node.input(0).knob(\"colorspace\").value()\n            if \"default\" in inputColorspace:\n                nuke.message(\"'default' values are not allowed\")\n            else:\n                nuke.thisNode().knob(\"colorspaceString\").setValue(inputColorspace)\n        except:\n            nuke.message(\"You need a readnode with a dot that have 'plate' in the label\")"}
 addUserKnob {26 ""}
 addUserKnob {20 createwritenodes_group l "Create Write nodes" n 1}
 addUserKnob {6 createCompWrite_enable l "" t "disable to bypass" +STARTLINE +STARTLINE}
 createCompWrite_enable true
 addUserKnob {22 createCompWrite l Comp -STARTLINE T "this = nuke.thisNode()\n\ncomp_dot_found = False\n\nfor node in nuke.allNodes():\n    node.setSelected(False)\n\n\ndef find_dot_node(dot_label):\n\n    for node in nuke.allNodes(\"Dot\"):\n        if node\[\"label\"].getValue() == dot_label:\n            return node\n    # Return None if no node was found.\n    return None\n\n\ndef create_comp_write_node():\n        \n        connection_node = find_dot_node(\"comp write\")\n        if connection_node == None:\n            connection_node = this\n        \n        connection_node.setSelected(True)\n           \n        #Create writenode\n        newWrite = nodegraph.create_custom_writenode()\n        newWrite\[\"type\"].setValue(\"comp\")\n        \n        #colorspace\n        if not this.knob(\"write_colorspace_string\").value() == \"\":\n            newWrite\[\"colorspace\"].setValue(this.knob(\"write_colorspace_string\").value())\n        else:\n            newWrite\[\"colorspace\"].setValue(this.knob(\"colorspaceString\").value())  \n              \n        if this.knob(\"all_metadata\").value() == True:\n            newWrite\[\"metadata\"].setValue(\"all metadata\")\n\n        newWrite\[\"packetsize\"].setValue(8)\n        newWrite\[\"keepversions\"].setValue(5)\n        \n        \n        \n        #Compression\n        if not this.knob(\"compression_string\").value() == \"\":\n            newWrite\[\"compression\"].setValue(this.knob(\"compression_string\").value())\n\n\n        #Custom name\n        if this.knob(\"cname_enable\").value() == True:\n            #Look through dropdown menu for a match\n            running = True\n            while running:\n                for cname_option in newWrite.knob(\"cname_option\").values():\n                    if cname_option == this.knob(\"custom_name\").value():\n                        print (\"found:    \" + cname_option)\n                        newWrite.knob(\"cname_option\").setValue(cname_option)\n                        this.knob(\"custom_name\").setValue(cname_option)\n                        running = False\n                    if not nuke.thisNode().knob(\"custom_name\").value() == \"\":\n                        newWrite.knob(\"cname_option\").setValue(this.knob(\"custom_name\").value())\n                        running = False\n                    else:\n                        running = False\n\n        #Comment\n        comment_string = this.knob(\"write_comment_string\").value()\n        if not comment_string == \"\":\n            newWrite\[\"comments\"].setValue(comment_string)        \n\n        # version and frame digits\n        try:\n            newWrite\[\"version_digits\"].setValue(int(this.knob(\"version_digits\").value()))\n            newWrite\[\"frame_digits\"].setValue(int(this.knob(\"frame_digits\").value()))\n        except:\n            print(\"Error: Could not set value for 'version_digits' and/or 'frame_digits' knobs.\")\n            \n        \n        # preview settings\n        \n        previewKnobs = \[\n        \"project_name\",\n        \"preview_codec\",\n        \"preview_slate\",\n        \"preview_format\",\n        \"LUT_colorspaceIn\",\n        \"LUT_colorspaceOut\",\n        \"preview_colorspaceOut\",\n        \"preview_fps\",\n        \"preview_resize\",\n        \"preview_aspect\",\n        \"preview_borders\",\n        \"preview_addtimecode_node\"\n        ]\n                \n        for knob in previewKnobs:\n            try:\n                knobvalue = this.knob(knob).value()\n                if not knobvalue == None:\n                    newWrite.knob(knob).setValue(knobvalue)\n            except:\n                print(f\"Error: Could not set value for the \{knob\} knob.\")\n        \n        #if not ACES, temp solution for \"preview_colorspaceOut\"\n        try:\n            if this.knob(\"preview_colorspaceOut\"):\n                if not nukesession.get_colorManagement() == 'ACES':\n                    if \"Output - sRGB\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"sRGB\")\n                    elif \"Output - Rec.709\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"rec709\")\n                \n                else:\n                    newWrite.knob(\"preview_colorspaceOut\").setValue(this.knob(\"preview_colorspaceOut\").value())\n        except:\n            print(\"Could not set value for a preview_colorspaceOut knob\")\n        \n        #Hide if box is checked\n        if this\[\"hide_in_properties_bin\"]:\n            if this\[\"hide_in_properties_bin\"].value():\n                newWrite.hideControlPanel()\n        \n\ncreate_comp_write_node()"}
 addUserKnob {6 createDenoiseWrite_enable l "" t "disable to bypass" -STARTLINE}
 createDenoiseWrite_enable true
 addUserKnob {22 createDenoiseWrite l Denoise -STARTLINE T "for node in nuke.allNodes():\n    node.setSelected(False)\n\nfor node in nuke.allNodes(\"Dot\"):\n    if node\[\"label\"].getValue() == \"denoise write\":\n        first = int(nuke.knob(\"first_frame\"))\n        last = int(nuke.knob(\"last_frame\"))\n        node.setSelected(True)      \n        \n        newWrite = nodegraph.create_custom_writenode()\n        newWrite\[\"type\"].setValue(\"element\")\n        newWrite\[\"new_el\"].setValue(\"denoise\")\n        \n        newWrite\[\"packetsize\"].setValue(20)\n        if not nuke.thisNode().knob(\"compression_string\").value() == \"\":\n            newWrite\[\"compression\"].setValue(nuke.thisNode().knob(\"compression_string\").value())\n\n        try:\n            newWrite\[\"version_digits\"].setValue(int(this.knob(\"version_digits\").value()))\n            newWrite\[\"frame_digits\"].setValue(int(this.knob(\"frame_digits\").value()))\n        except:\n            print(\"Error: Could not set value for 'version_digits' and/or 'frame_digits' knobs.\")\n\n        if this\[\"hide_in_properties_bin\"]:\n            if this\[\"hide_in_properties_bin\"].value():\n                newWrite.hideControlPanel()"}
 addUserKnob {6 createTCWrite_enable l "" -STARTLINE}
 addUserKnob {22 createTCWrite l TC -STARTLINE T "this = nuke.thisNode()\n\nfor node in nuke.allNodes():\n    node.setSelected(False)\n\nfor node in nuke.allNodes(\"Dot\"):\n    if node\[\"label\"].getValue() == \"TC write\":\n        node.setSelected(True)\n        \n        newWrite = nodegraph.create_custom_writenode()\n        newWrite\[\"type\"].setValue(\"plate\")\n        newWrite\[\"new_el\"].setValue(\"TC\")\n        newWrite\[\"channels\"].setValue(\"rgb\")\n        \n        newWrite\[\"metadata\"].setValue(\"all metadata\")\n        newWrite\[\"colorspace\"].setValue(nuke.thisNode().knob(\"colorspaceString\").value())\n        newWrite\[\"packetsize\"].setValue(8)\n        if not nuke.thisNode().knob(\"compression_string\").value() == \"\":\n            newWrite\[\"compression\"].setValue(nuke.thisNode().knob(\"compression_string\").value())\n                    \n        newWrite\[\"ftrack_review_enabled\"].setValue(False)\n        newWrite\[\"upversion_on_farmrender\"].setValue(False)\n        newWrite\[\"autocleanup\"].setValue(False)\n        newWrite\[\"keepversions\"].setValue(3)\n        \n        try:\n            newWrite\[\"version_digits\"].setValue(int(this.knob(\"version_digits\").value()))\n            newWrite\[\"frame_digits\"].setValue(int(this.knob(\"frame_digits\").value()))\n        except:\n            print(\"Error: Could not set value for 'version_digits' and/or 'frame_digits' knobs.\")  \n            \n        #Comment\n        comment_string = this.knob(\"write_comment_string\").value()\n        if not comment_string == \"\":\n            newWrite\[\"comments\"].setValue(comment_string)        \n\n        # version and frame digits\n        try:\n            newWrite\[\"version_digits\"].setValue(int(this.knob(\"version_digits\").value()))\n            newWrite\[\"frame_digits\"].setValue(int(this.knob(\"frame_digits\").value()))\n        except:\n            print(\"Error: Could not set value for 'version_digits' and/or 'frame_digits' knobs.\")\n            \n        \n        # preview settings\n        \n        previewKnobs = \[\n        \"project_name\",\n        \"preview_codec\",\n        \"preview_slate\",\n        \"preview_format\",\n        \"LUT_colorspaceIn\",\n        \"LUT_colorspaceOut\",\n        \"preview_colorspaceOut\",\n        \"preview_fps\",\n        \"preview_resize\",\n        \"preview_aspect\",\n        \"preview_borders\",\n        \"preview_addtimecode_node\"\n        ]\n                \n                \n        for knob in previewKnobs:\n            try:\n                knobvalue = this.knob(knob).value()\n                if not knobvalue == None:\n                    newWrite.knob(knob).setValue(knobvalue)\n            except:\n                print(f\"Error: Could not set value for the \{knob\} knob.\")\n        \n        #if not ACES, temp solution for \"preview_colorspaceOut\"\n        try:\n            if this.knob(\"preview_colorspaceOut\"):\n                if not nukesession.get_colorManagement() == 'ACES':\n                    if \"Output - sRGB\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"sRGB\")\n                    elif \"Output - Rec.709\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"rec709\")\n                \n                else:\n                    newWrite.knob(\"preview_colorspaceOut\").setValue(this.knob(\"preview_colorspaceOut\").value())\n        except:\n            print(\"Could not set value for a preview_colorspaceOut knob\")\n            \n        #Hide if box is checked\n        if this\[\"hide_in_properties_bin\"]:\n            if this\[\"hide_in_properties_bin\"].value():\n                newWrite.hideControlPanel()"}
 addUserKnob {6 hide_in_properties_bin l "Hide in properties" t "Set true if you don't want the node to show up in the properties bin." +STARTLINE}
 addUserKnob {20 endGroup_1 l endGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {22 open_explorer l "open script path" t "Go to the scripts location in your OS" T "import subprocess\nimport os\n\n# Get the current script path\nscript_path = nuke.root().name()\n\n# Extract the directory path and normalize it\nscript_directory = os.path.normpath(os.path.dirname(script_path))\n\n# Open the script location in Windows File Explorer\nsubprocess.Popen(f'explorer \"\{script_directory\}\"')\n" +STARTLINE}
 addUserKnob {26 text_1 l "" +STARTLINE T "   "}
 addUserKnob {6 replace_local_check l "" +STARTLINE +STARTLINE}
 replace_local_check true
 addUserKnob {22 replace_local_path l "Replace Z:/" t "Quick fix for readnodes that contains \"Z:/\" in the beginning of the file knob, this will change it to \"//fs/data/\" so it will work on the farm." -STARTLINE T "for readnode in nuke.allNodes(\"Read\"):\n    read_file_knob = readnode.knob(\"file\")\n    localPath = \"Z:/\"\n    replacePath = \"//fs/data/\"\n    if localPath in read_file_knob.getValue():\n        new_path = read_file_knob.getValue().replace(localPath,replacePath)\n        print (f\"root path updated:  \{new_path\}\")\n        read_file_knob.setValue(new_path)"}
 addUserKnob {6 convert_version_enable l "" +STARTLINE +STARTLINE}
 addUserKnob {22 convert_version l "Convert version digits" t "Converting fx v003 to v0003;\nIf v001 and v002 are in the script, they will be moved to the \"scripts/backup\" folder." -STARTLINE T "import os\nimport shutil\nimport nuke\nimport re\nimport paths\n\n\ndef save_script_with_four_digits():\n    # Get the current script path\n    script_path = nuke.root().name()\n    \n    # Check if the script has a valid name\n    if not script_path:\n        nuke.message(\"Please save the script before running this script.\")\n        return\n\n    # Get the script directory and name without extension\n    script_dir, script_name = os.path.split(script_path)\n    script_name, _ = os.path.splitext(script_name)\n\n    # Extract the version number from the current script name\n\n    if re.match(r\".*_v\\d\{3\}\$\", script_name):\n        #print(script_name)\n        # Generate the new script name with four digits\n        \n        script_name_split = re.split(r'_v(\\d\{3\})', script_name)\n        script_name_before = script_name_split\[0]\n        script_version = script_name_split\[1]\n        script_name_after = script_name_split\[-1]\n        \n        if script_version.isdigit():\n            script_version_padded = script_version.zfill(4)\n        else:\n            return nuke.message(\"Error while extracting the version number, make sure your scripts name have a version number, examples: 'example_script_v001.nk'\")\n\n    \n    \n        new_script_path = f\"\{script_dir\}/\{script_name_before\}_v\{script_version_padded\}\{script_name_after\}.nk\"\n    \n        # Backup\n        nuke.scriptSaveAs(f\"\{script_dir\}/\{script_name\}.nk_backup\")    \n        \n        # Save the script with the new name\n        nuke.scriptSaveAs(new_script_path)\n\n        return nuke.message(f\"Script saved as: \{new_script_path\}, since the knob 'convert_version' was executed\")\n    else:\n        return nuke.message(\"Script name does not match the expected format when trying to convert it.\")\n        \ndef backup_3_digits_versions():\n    script_path = nuke.root().name()\n    # Get the script directory and name without extension\n    script_dir, script_name = os.path.split(script_path)\n    script_name, _ = os.path.splitext(script_name)\n    backup_folder = f\"\{script_dir\}/backup/\"\n\n    if not os.path.exists(backup_folder):\n        os.mkdir(backup_folder)\n    # Extract the version number from the current script name\n\n\n    script_name_split = re.split(r'_v(\\d\{3\})', script_name)\n    script_name_before = script_name_split\[0]\n\n    list_of_scripts = os.listdir(script_dir)\n    print(\"Before: \"+ script_name_before)\n\n    #print(script_name_before)\n    for file in list_of_scripts:\n        #print(file)\n        if file.startswith(script_name_before):\n            \n            \n            script_name = re.split('.nk', file)\[0]\n            #print(script_name)\n            \n            script_name_split = re.split(f\"\{script_name_before\}_v\",script_name)\[-1]\n            #print(script_name_split)\n            if script_name_split.isdigit() and len(script_name_split) == 3:\n                #print(script_name_split)\n                file_from = f\"\{script_dir\}/\{file\}\"\n                file_to = f\"\{backup_folder\}\{file\}\"\n                print(f\"fr: \{file_from\}\")\n                print(f\"to: \{file_to\}\")\n                shutil.move(file_from,file_to)\n        \n\n        \n\nsave_script_with_four_digits()\nbackup_3_digits_versions()"}
 addUserKnob {26 ""}
 addUserKnob {26 text l "" +STARTLINE T "All selected above\n"}
 addUserKnob {22 buildScript l "Build script" t "Build your script with all boxes ticked in" T "\ntnk = nuke.thisNode().knob\n\ncheck_execute_dict = \{\n    \"importscriptHelper\": \"import_enable\",\n    \"createScriptSetup\": \"createScriptSetup_enable\",\n    \"convert_version\":\"convert_version_enable\",\n    \"getPlate\": \"getPlate_enable\",\n    \"getRef\": \"getRef_enable\",\n    \"viewerprocess\": \"viewerprocess_enable\",\n    \"customviewer_process\": \"custom_viewerProcess_enabled\",\n    \"plateColorspace\": \"plateColorspace_enable\",\n    \"createDenoiseWrite\": \"createDenoiseWrite_enable\",\n    \"createCompWrite\": \"createCompWrite_enable\",\n    \"createTCWrite\": \"createTCWrite_enable\",\n    \"update_metadata\": \"update_metadata_enable\"\n\n\}\n\nfor script, key in check_execute_dict.items():\n    if tnk(key).value() == True:\n        try:\n            tnk(script).execute()\n        except:\n            print(f\"Error when trying to execute \{script\}\")\n\n\"\"\"\nif tnk(\"import_enable\").value() == True:\n    tnk(\"importscriptHelper\").execute()\n    \nif tnk(\"createScriptSetup_enable\").value() == True:\n    tnk(\"createScriptSetup\").execute()    \n\nif tnk(\"getPlate_enable\").value() == True:\n    tnk(\"getPlate\").execute()\n    \nif tnk(\"getRef_enable\").value() == True:\n    tnk(\"getRef\").execute()\n\nif tnk(\"viewerprocess_enable\").value() == True:\n    tnk(\"viewerprocess\").execute()\n    \nif tnk(\"custom_viewerProcess_enabled\").value() == True:\n    tnk(\"customviewer_process\").execute()\n\nif tnk(\"plateColorspace_enable\").value() == True:\n    tnk(\"plateColorspace\").execute()\n\nif tnk(\"createDenoiseWrite_enable\").value() == True:\n    tnk(\"createDenoiseWrite\").execute()\n\nif tnk(\"createCompWrite_enable\").value() == True:\n    tnk(\"createCompWrite\").execute()\n    \nif tnk(\"createTCWrite_enable\").value() == True:\n    tnk(\"createTCWrite\").execute()\n    \nif tnk(\"update_metadata_enable\").value() == True:\n    tnk(\"update_metadata\").execute()\n\"\"\"" +STARTLINE}
 addUserKnob {20 checklist l Checklist +INVISIBLE}
 addUserKnob {26 checklist_text l info +INVISIBLE T "1. Compare with offline\n    a) Framerange \n    b) Retimes\n    c) Reframing\n2. Setup reduce noise and export.\n3. Setup timing and framing to match offline.\n4. Setup das_grain when denoise is done."}
 addUserKnob {6 compare_offline_boolean l "Compare with reference" +STARTLINE}
 addUserKnob {22 compare_plate_and_ref l "Compare plate to ref" T "for node in nuke.allNodes(\"BackdropNode\"):\n    if \"Offline / reference\" in node\[\"label\"].value():\n\n        xC = node.xpos()+ 100 + node.screenWidth()/2\n        yC = (node.ypos() + 100) + node.screenHeight()/2\n        nuke.zoom( 0.75, \[ xC, yC ])\n\n        break" +STARTLINE}
 addUserKnob {6 setup_reduce_noise_boolean l "Setup reduce noise" +STARTLINE}
 addUserKnob {22 setup_reducenoise l "Setup reduce noise" T "node = nuke.toNode(\"Dot_reduceNoise1\")\nxC = node.xpos() + node.screenWidth()/2\nyC = (node.ypos() + 100) + node.screenHeight()/2\nnuke.zoom( 1.75, \[ xC, yC ])" +STARTLINE}
 addUserKnob {6 das_grain_setup_boolean l "Das Grain setup" +STARTLINE}
 addUserKnob {22 go_to_dasgrain l DasGrain T "for node in nuke.allNodes(\"BackdropNode\"):\n    if \"Das Grain\" in node\[\"label\"].value():\n        #node = nuke.toNode(\"Dot_reduceNoise1\")\n\n        xC = node.xpos() + node.screenWidth()/2\n        yC = (node.ypos() + 100) + node.screenHeight()/2\n        nuke.zoom( 1.75, \[ xC, yC ])\n        \n        node.selectNodes(True)\n        for i in nuke.selectedNodes():\n            if \"DasGrain\" in i.name():\n                i\[\"disable\"].setValue(False)\n                for node in nuke.allNodes():\n                    if node.Class() == \"NoOp\":\n                        if node.knob(\"title\"):\n                            if \"denoise plate01\" in node\[\"title\"].value():\n                                if node.input(0).Class() == \"Read\":\n                                    if nuke.thisNode().knob(\"analyze_check\").getValue() == True:\n                                        i\[\"analyze\"].execute()\n                                else:\n                                    nuke.message(\"Please connect a readnode before you analyse\")\n        break" +STARTLINE}
 addUserKnob {6 analyze_check l "start analyze" -STARTLINE}
 analyze_check true
 addUserKnob {6 tc_setup_check l "TC setup" +STARTLINE}
 addUserKnob {22 tc_boolean l TC T "for node in nuke.allNodes(\"BackdropNode\"):\n    if \"TC\" in node\[\"label\"].value():\n\n        xC = node.xpos() + node.screenWidth()/2\n        yC = (node.ypos() + 100) + node.screenHeight()/2\n        nuke.zoom( 0.6, \[ xC, yC ])\n        " +STARTLINE}
