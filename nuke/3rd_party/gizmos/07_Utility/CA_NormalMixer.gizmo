Group {
 name CA_NormalMixerV2
 tile_color 0x4f7fbfff
 note_font "Verdana Bold"
 selected true
 addUserKnob {20 Settings}
 addUserKnob {26 title l "" +STARTLINE T "<b><font size='4' color='#5F9FDF'>CA_NormalMixer</font></b>"}
 addUserKnob {26 subtitle l "" +STARTLINE T "<font size='2' color='#888'>Blend normal maps using Reoriented Normal Mapping</font>"}
 addUserKnob {26 divider1 l "" +STARTLINE T " "}
 addUserKnob {7 mix l Mix t "Dissolve between base normals and blended result.\n0 = pure base normals.\n1 = full detail blend."}
 mix 1
 addUserKnob {26 divider2 l "" +STARTLINE T " "}
 addUserKnob {4 blend_mode l "Blend Mode" t "RNM: Reoriented Normal Mapping (most accurate)\nUDN: Whiteout blending (fast, good quality)\nLinear: Simple addition (fastest, least accurate)" M {"Reoriented (RNM)" "UDN (Whiteout)" Linear ""}}
 addUserKnob {26 divider3 l "" +STARTLINE T " "}
 addUserKnob {6 input_signed l "Inputs are Signed (-1 to 1)" t "Enable if normal maps are in -1 to 1 range.\nDisable if they are in 0 to 1 range." +STARTLINE}
 input_signed true
 addUserKnob {26 divider_edge l "" +STARTLINE T " "}
 addUserKnob {26 edge_label l "" +STARTLINE T "<b><font color='#5F9FDF'>Edge Protection</font></b>"}
 addUserKnob {26 edge_subtitle l "" +STARTLINE T "<font size='2' color='#888'>Suppress detail at silhouette edges to prevent hard edge artifacts</font>"}
 addUserKnob {6 edge_protect l "Enable Edge Protection" t "Fades out detail blending where the base normal faces away from camera (silhouette edges).\nPrevents hard edge artifacts from luminance-derived detail normals." +STARTLINE}
 edge_protect true
 addUserKnob {7 edge_threshold l Threshold t "Base normal Z value below which detail starts fading.\nHigher = more aggressive protection, affects more of the surface.\nLower = only protects extreme edges."}
 edge_threshold 0.025
 addUserKnob {7 edge_softness l Softness t "Width of the falloff zone between full detail and no detail.\nHigher = smoother, more gradual transition.\nLower = sharper cutoff." R 0.01 1}
 edge_softness 0.17
 addUserKnob {7 edge_gradient_protect l "Gradient Clamp" t "Suppress detail where the detail normal itself has extreme XY gradients (hard luminance discontinuities).\n0 = disabled. Higher = more aggressive clamping of extreme detail normals."}
 edge_gradient_protect 0.645
 addUserKnob {26 divider4 l "" +STARTLINE T " "}
 addUserKnob {26 inputs_label l "" +STARTLINE T "<font size='2' color='#888'><b>A input</b> = Base normals (AI or CG render)<br><b>B input</b> = Detail normals (from CA_LumaToNormals)</font>"}
 addUserKnob {26 info l "" +STARTLINE T "<font size='1' color='#666'>Compositing Academy | RNM normal blending</font>"}
 addUserKnob {26 divider5 l "" +STARTLINE T " "}
}
 Input {
  inputs 0
  name detail
  label "B: Detail Normals"
  xpos 200
  ypos -200
  number 1
 }
 Input {
  inputs 0
  name base
  label "A: Base Normals"
  xpos 0
  ypos -200
 }
set Nc010000 [stack 0]
 BlinkScript {
  inputs 2
  recompileCount 1
  ProgramGroup 1
  KernelDescription "3 \"NormalMixer\" iterate pixelWise 9aba08a538c31485b440d37cbfc908fc367f769fc7923b62e5607b5872fbaf8d 3 \"base\" Read Point \"detail\" Read Point \"dst\" Write Point 6 \"blend_mode\" Int 1 AAAAAA== \"input_signed\" Bool 1 AQ== \"edge_protect\" Bool 1 AQ== \"edge_threshold\" Float 1 AACAPg== \"edge_softness\" Float 1 mpkZPg== \"edge_gradient_protect\" Float 1 AAAAPw== 6 \"blend_mode\" 1 1 Default \"input_signed\" 1 1 Default \"edge_protect\" 1 1 Default \"edge_threshold\" 1 1 Default \"edge_softness\" 1 1 Default \"edge_gradient_protect\" 1 1 Default 0"
  EncodedSource "1 3917 "
  vectorize false
  rebuild ""
  NormalMixer_blend_mode {{parent.blend_mode}}
  NormalMixer_input_signed {{parent.input_signed}}
  NormalMixer_edge_protect {{parent.edge_protect}}
  NormalMixer_edge_threshold {{parent.edge_threshold}}
  NormalMixer_edge_softness {{parent.edge_softness}}
  NormalMixer_edge_gradient_protect {{parent.edge_gradient_protect}}
  rebuild_finalise ""
  name NormalMixer_Blink
  xpos 200
  ypos -29
 }
push $Nc010000
 Dissolve {
  inputs 2
  which {{parent.mix}}
  name Dissolve_mix
  xpos 0
  ypos -29
 }
 Output {
  name Output1
  xpos 0
  ypos 93
 }
end_group
