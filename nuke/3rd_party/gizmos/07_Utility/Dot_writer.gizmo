set cut_paste_input [stack 0]
version 14.0 v3
push $cut_paste_input
Dot {
 name Dot_writer
 knobChanged "this = nuke.thisNode()\n\ncolorspace = nuke.thisNode().knob(\"colorspace\")\nocio_config = nuke.Root()\[\"OCIO_config\"].value()\n\n\n#Colorspace according to ocio settings\nif \"aces\" in ocio_config:\n    colorspace.setValues(\['ACES - ACEScg', 'Utility - sRGB - Texture', 'Input - ARRI - V3 - LogC (EI800) - Wide Gamut'])\n    this\[\"aces_check\"].setValue(True)\nelse:\n    colorspace.setValues(\['linear', 'sRGB', 'AlexaV3LogC'])\n    this\[\"aces_check\"].setValue(False)\n\nif \"exr\" in this\[\"file_type\"].value():\n    this\[\"datatype\"].setVisible(True)\nelse:\n    this\[\"datatype\"].setVisible(False)\n\nif \"jpeg\" in this\[\"file_type\"].value():\n    this\[\"_jpeg_quality\"].setVisible(True)\n    this\[\"_jpeg_sub_sampling\"].setVisible(True)\nelse:\n    this\[\"_jpeg_quality\"].setVisible(False)\n    this\[\"_jpeg_sub_sampling\"].setVisible(False)\n    \nif \"png\" in this\[\"file_type\"].value():\n    this\[\"png_data_type\"].setVisible(True)\nelse:\n    this\[\"png_data_type\"].setVisible(False)\n    \nif this\[\"update_label\"].value() == True:\n    this\[\"label\"].setValue(this\[\"preset_text\"].value())\n\"\"\"    \nif \"plate\" in this\[\"type_write\"].value():\n    this\[\"ftrack_review_enabled\"].setVisible(True)\nelse:\n    this\[\"ftrack_review_enabled\"].setVisible(False)\n    this\[\"ftrack_review_enabled\"].setValue(False)\n\"\"\""
 tile_color 0xfff810ff
 label precomp
 selected true
 addUserKnob {20 User}
 addUserKnob {22 labelWriteNode l "Create label writenode" T "#def presets():\n#    knobs = \[\"channels\",\"colorspace\",\"file_type\",\"_jpeg_quality\",]\n#    jpeg_knobs = \[\"_jpeg_quality\", \"_jpeg_sub_sampling\"]\nimport paths\n\ndef fix_readnodes():\n\n    for readnode in nuke.allNodes(\"Read\"):\n        read_file_knob = readnode.knob(\"file\")\n        localPath = \"Z:/\"\n        replacePath = \"//fs/data/\"\n        if localPath in read_file_knob.getValue():\n            new_path = read_file_knob.getValue().replace(localPath,replacePath)\n            print (f\"root path updated:  \{new_path\}\")\n            read_file_knob.setValue(new_path)\n            \n\n#################    PART 1  ###################\n\n# Main section\nthis = nuke.thisNode()\n\n#clean the variables\n\nfirst_frame = int(nuke.root()\[\"first_frame\"].value())\nlast_frame = int(nuke.root()\[\"last_frame\"].value())\nproj = \"\"\nseq = \"\"\nshot = \"\"\n\n#current_proj,current_seq,current_shot = paths.get_projectname(), paths.get_sequence(),paths.get_shot()\nif this is not None:\n\n    topnode_name = nuke.tcl(\"full_name \[topnode %s]\" % this.name())\n    topnode = nuke.toNode(topnode_name)\n\n\n    if topnode is not None and topnode.Class() == \"Read\":\n        \n        # Extract frame range\n        first_frame = int(topnode\[\"first\"].value())\n        last_frame = int(topnode\[\"last\"].value())\n        \n        # Check for required knobs\n        if topnode.knob(\"proj\") and topnode.knob(\"seq\") and topnode.knob(\"shot\"):\n            proj = topnode\[\"proj\"].value()\n            seq = topnode\[\"seq\"].value()\n            shot = topnode\[\"shot\"].value()\n\n        else:\n            print(\"pipeline knobs not present, falling back to readnodes path\")\n            filename = nuke.filename(topnode)\n            if 'Z:/' in filename:\n                nuke.messege(\"'Z:/' is not allowed, replacing all readnodes to '//fs/data/'\")\n                fix_readnodes()\n                \n            if '//fs/data' in filename:\n            \n                namelist = (filename.split(\"/\"))\n                proj = namelist\[4]\n                seq = namelist\[6]\n                shot = namelist\[7]\n                print (\"filepath: \", proj,seq,shot)\n            \nelse:\n    print(\"Error...\")\n\n\n#################    PART 2  ###################\n\n\n# Set only this node as selected\nfor nodes in nuke.selectedNodes():\n    nodes.setSelected(False)\n\nthis.setSelected(True)\n\nif this\[\"create_crop_check\"].value() == True:\n    this\[\"crop_to_input_execute\"].execute()\n\nif this\[\"create_reformat_check\"].value() == True:\n    this\[\"create_reformat_execute\"].execute()\n\nif this\[\"add_log_colorspace_check\"].value() == True:\n    this\[\"add_log_colorspace\"].execute()\n\n\n# Get first line of label\n# Rest are comments\ndotname = nuke.thisNode()\[\"label\"].getValue().split(\"/n\")\[0]\n \n\n# Create a custom writenode\nnewWrite = nodegraph.create_custom_writenode()\n\nnewWrite.knob(\"proj\").setValue(proj)\nnewWrite.knob(\"seq\").setValue(seq)\nnewWrite.knob(\"shot\").setValue(shot)\n\nif \"element\" in this\[\"type_write\"].value():\n    newWrite\[\"type\"].setValue(\"element\")\nif \"plate\" in this\[\"type_write\"].value():\n    newWrite\[\"type\"].setValue(\"plate\")\n\nnewWrite\[\"new_el\"].setValue(dotname)\nnewWrite\[\"colorspace\"].setValue(this\[\"colorspace\"].value())\n\n# Set file type \nfile_type = this\[\"file_type\"].value()\nfile_ext = \".\" + str(this\[\"file_type\"].value())\n\nnewWrite\[\"file_type\"].setValue(this\[\"file_type\"].value())\n\n# Update file extention string\nfileext = newWrite\[\"file\"].value()\nfileext = fileext.replace(\".exr\", file_ext)\n\nnewWrite\[\"file\"].setValue(fileext)\n\n\nnewWrite\[\"channels\"].setValue(this\[\"channels\"].value())\n\nnewWrite\[\"packetsize\"].setValue(int(this\[\"packet_size\"].value()))\nnewWrite\[\"chunktimeout\"].setValue(int(this\[\"chunktimeout\"].value()))\nnewWrite\[\"keepversions\"].setValue(int(this\[\"keepversions\"].value()))\n\nif \"exr\" in file_type:\n    newWrite\[\"datatype\"].setValue(this\[\"datatype\"].value())\n\nif \"jpeg\" in file_type:\n    newWrite\[\"_jpeg_quality\"].setValue(this\[\"_jpeg_quality\"].value())\n    newWrite\[\"_jpeg_sub_sampling\"].setValue(this\[\"_jpeg_sub_sampling\"].value())\n    newWrite\[\"channels\"].setValue(\"rgb\")\n    \nif \"png\" in file_type:\n    newWrite\[\"datatype\"].setValue(this\[\"png_data_type\"].value())\n    if \"all\" in this\[\"channels\"].value():\n        newWrite\[\"channels\"].setValue(\"rgba\")\n\nif \"STMap\" in this\[\"label\"].value():\n    first_frame = 1001\n    last_frame = 1001\n    newWrite\[\"packetsize\"].setValue(1)\n    \nnewWrite\[\"use_limit\"].setValue(True)\nnewWrite\[\"first\"].setValue(first_frame)\nnewWrite\[\"last\"].setValue(last_frame)\n\nnewWrite\[\"ftrack_review_enabled\"].setValue(this\[\"ftrack_review_enabled\"].value())\nnewWrite\[\"upversion_on_farmrender\"].setValue(this\[\"upversion_on_farmrender\"].value())\n\n\n\n# Set input and autoplace node\nnewWrite.setInput(0, this)\nnuke.autoplace(newWrite)\n\nnewWrite.setSelected(False)\n\n# For single quick exports\nif not this\[\"executing_multiple_check\"].value() == True:\n    if this\[\"send_to_farm\"].value() == True:\n        for node in nuke.selectedNodes():\n            node.setSelected(False)\n        newWrite.setSelected(True)\n        import scripts.shortcut_ctrl_r;scripts.shortcut_ctrl_r.main()" +STARTLINE}
 addUserKnob {6 send_to_farm l "Confident sending to farm" t "This will send the job to the renderfarm after it created the node. " -STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {1 preset_text l Name}
 preset_text precomp
 addUserKnob {6 update_label l "update label?" -STARTLINE}
 update_label true
 addUserKnob {35 menu l presets t "Changes knobs in this node, hides knobs that are unrelevant," M {precomp "knob \"preset_text\" \"precomp\"; knob \"file_type\" \"exr\"; knob \"colorspace\" 0; knob \"type_write\" \"element\"; knob \"datatype\" \"16 bit half\"" denoise_plate "knob \"preset_text\" \"denoise_plate\"; knob \"file_type\" \"exr\"; knob \"colorspace\" 0; knob \"type_write\" \"plate\"; knob \"datatype\" \"16 bit half\"" 3D_imageplane "knob \"preset_text\" \"3D_imageplane\"; knob \"file_type\" \"jpeg\"; knob \"_jpeg_quality\" 0.97; knob \"_jpeg_sub_sampling\" \"4:1:1\"; knob \"channels\" \"rgb\"; knob \"colorspace\" 1; knob \"type_write\" \"plate\"" 3D_lighting "knob \"preset_text\" \"3D_lighting\"; knob \"file_type\" \"exr\"; knob \"colorspace\" 0; knob \"type_write\" \"plate\"; knob \"datatype\" \"16 bit half\"" tracking_png "knob \"preset_text\" \"tracking_png\"; knob \"file_type\" \"png\"; knob \"colorspace\" 2; knob \"type_write\" \"plate\"" STMap_undistort "knob \"preset_text\" \"STMap_undistort\"; knob \"file_type\" \"exr\"; knob \"colorspace\" 0; knob \"type_write\" \"element\"; knob \"datatype\" \"32 bit float\"" STMap_redistort "knob \"preset_text\" \"STMap_redistort\"; knob \"file_type\" \"exr\"; knob \"colorspace\" 0; knob \"type_write\" \"element\"; knob \"datatype\" \"32 bit float\"" ""}}
 addUserKnob {26 presetsinfo l <-- -STARTLINE T "This might override your settings"}
 addUserKnob {4 type_write l type M {element plate "" "" ""}}
 addUserKnob {26 ""}
 addUserKnob {4 channels t "Choose channels to output, add your own if needed." M {all rgba rgb ""}}
 channels rgb
 addUserKnob {6 aces_check l "ACES check" +INVISIBLE +STARTLINE}
 addUserKnob {4 colorspace M {linear sRGB AlexaV3LogC}}
 addUserKnob {4 file_type l filetype M {exr png jpeg "" "" "" "" "" ""}}
 addUserKnob {7 _jpeg_quality l quality +HIDDEN}
 _jpeg_quality 0.97
 addUserKnob {68 _jpeg_sub_sampling l sub-sampling +HIDDEN M {4:1:1 4:2:2 4:4:4 "" "" "" ""}}
 _jpeg_sub_sampling 4:2:2
 addUserKnob {68 png_data_type l "data type" +HIDDEN M {"8 bit" "16 bit" "" "" "" ""}}
 addUserKnob {4 datatype l "data type" M {"16 bit half" "32 bit float" "" ""}}
 addUserKnob {26 ""}
 addUserKnob {20 extra_settings_group l "Extra settings" n 1}
 extra_settings_group 0
 addUserKnob {6 ftrack_review_enabled l "ftrack review" +STARTLINE}
 addUserKnob {6 upversion_on_farmrender l "version up script" -STARTLINE}
 addUserKnob {3 packet_size l "packet size"}
 packet_size 6
 addUserKnob {3 chunktimeout l "chunk timeout"}
 chunktimeout 15
 addUserKnob {3 keepversions l "Keep versions"}
 keepversions 5
 addUserKnob {20 endGroup_1 l endGroup n -1}
 addUserKnob {26 ""}
 addUserKnob {20 features_group l "Extra features" n 1}
 features_group 0
 addUserKnob {22 add_log_colorspace l "Log colorspace node" t "If you don't want to export in AlexaV3LogC colorspace, we can create a colorspace-node" +INVISIBLE T "this = nuke.thisNode()\ninputnode = this.input(0)\n\n\n#Colorspace according to ocio settings\nif this\[\"aces_check\"].value() == True:\n    colorspace_in_string, colorspace_out_string = 'ACES - ACEScg', 'Input - ARRI - V3 - LogC (EI800) - Wide Gamut'\nelse:\n    colorspace_in_string, colorspace_out_string = 7.0,19.0 #Linear, AlexaV3LogC\n\nlabel = '\[value colorspace_in] - \[value colorspace_out]'\ncolorspace_node = nuke.createNode(\"Colorspace\", \"colorspace_in \{\} colorspace_out \{\}\".format(colorspace_in_string,colorspace_out_string))\ncolorspace_node.knob(\"label\").setValue(label)\n\ncolorspace_node.setInput(0,inputnode)\nthis.setInput(0, colorspace_node)\n\ncolorspace_node.setSelected(False)\nthis.setSelected(True)\n\n" +STARTLINE}
 addUserKnob {6 add_log_colorspace_check l "Add when executing" -STARTLINE +INVISIBLE}
 addUserKnob {22 crop_to_input_execute l "Crop input to format" T "this = nuke.thisNode()\ninputnode = nuke.thisNode().input(0)\ncrop_node = nuke.createNode(\"Crop\", inpanel = False)\ncrop_node\[\"crop\"].setValue(False)\n\ncrop_node.setInput(0,inputnode)\nthis.setInput(0, crop_node)\n\ncrop_node.setSelected(False)\nthis.setSelected(True)" +STARTLINE}
 addUserKnob {6 create_crop_check l "Add when executing" -STARTLINE}
 addUserKnob {22 create_reformat_execute l "Create reformat scale 0.5" T "this = nuke.thisNode()\ninputnode = nuke.thisNode().input(0)\n\nlabel = 'scale: \[value scale]'\nreformat_node = nuke.createNode(\"Reformat\", \"type scale scale 0.5 pbb False\")\nreformat_node.knob(\"label\").setValue(label)\n\nreformat_node.setInput(0,inputnode)\nthis.setInput(0, reformat_node)\n\nreformat_node.setSelected(False)\nthis.setSelected(True)" +STARTLINE}
 addUserKnob {6 create_reformat_check l "Add when executing" -STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {22 execute_all_button l "Generate write for all dotWriters in script" t "Execute all dotwritenodes in script that \n1. Has a readnode as a topnode. \n2. Have no writenode connected" T "conectedNodes = \[]\ndot_list = \[]\nrender_list = \[]\n\nfor dot_node in nuke.allNodes(\"Dot\"):\n    if not dot_node.knob(\"labelWriteNode\") == None:\n        write_node_connected = False\n        conectedNodes = nuke.dependentNodes(nodes=\[dot_node])\n        \n        # Cover for viewer nodes\n        for node in conectedNodes:\n            if \"Write\" in node.Class():\n                write_node_connected = True\n                #dot_node\[\"executing_multiple_check\"].setValue(True))\n        if write_node_connected == False:\n            dot_list.append(dot_node)\n\nfor node in nuke.selectedNodes():\n    node.setSelected(False)\n\nfor dot_node in dot_list:\n    if dot_node.knob(\"send_to_farm\") == True:\n        render_list.append(dot_node)\n    dot_node.knob(\"executing_multiple_check\").setValue(True)\n    dot_node.knob(\"labelWriteNode\").execute()\n    dot_node.knob(\"executing_multiple_check\").setValue(False)\n        \n\n        \nfor node in nuke.selectedNodes():\n    node.setSelected(False)\n    \n\n\n" +STARTLINE}
 addUserKnob {6 executing_multiple_check l "executing multiple" -STARTLINE +INVISIBLE}
 addUserKnob {20 endGroup n -1}
}
