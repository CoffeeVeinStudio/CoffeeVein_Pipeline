Group {
 name CA_NormalMask3
 tile_color 0x5fbfdfff
 note_font "Verdana Bold"
 selected true
 xpos 2815
 ypos 383
 addUserKnob {20 Settings}
 addUserKnob {26 title l "" +STARTLINE T "<b><font size='4' color='#5FBFDF'>CA_NormalMask</font></b>"}
 addUserKnob {26 subtitle l "" +STARTLINE T "<font size='2' color='#888'>Generate alpha mask from normal direction</font>"}
 addUserKnob {26 divider1 l "" +STARTLINE T " "}
 addUserKnob {4 dir_mode l "Direction Mode" t "Rotation: dial in a direction using rotation angles.\nSample: ctrl+click in the viewer to pick a normal direction from the image." M {Rotation Sample ""}}
 addUserKnob {26 divider2 l "" +STARTLINE T " "}
 addUserKnob {26 rot_label l "" +STARTLINE T "<font size='2' color='#aaa'><b>Rotation</b></font>"}
 addUserKnob {13 rotate l Rotate t "Rotate from camera-facing (0,0,1) to aim the mask.\n\nX = tilt up/down\nY = pan left/right\nZ = has no effect (roll doesn't change aim direction)"}
 rotate {85 0 0}
 addUserKnob {26 divider3 l "" +STARTLINE T " "}
 addUserKnob {26 sample_label l "" +STARTLINE T "<font size='2' color='#aaa'><b>Sample</b></font>"}
 addUserKnob {18 sampled_normal l "Sampled Normal" t "Ctrl+click in the viewer on the normal pass to pick a direction.\nThe RGB value at that pixel becomes the direction vector."}
 sampled_normal {0 0 1}
 addUserKnob {6 sampled_normal_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 divider4 l "" +STARTLINE T " "}
 addUserKnob {26 falloff_label l "" +STARTLINE T "<font size='2' color='#aaa'><b>Falloff</b></font>"}
 addUserKnob {7 softness l Softness t "Shape the falloff curve.\n1 = linear (diffuse-like).\nHigher = tighter, more concentrated (specular-like).\n\nLow (1-3) = broad diffuse wrap\nMedium (10-30) = soft specular\nHigh (50-200) = tight sharp specular" R 0.1 30}
 softness 1
 addUserKnob {7 range_min l "Range Min" t "Clip glancing angles. Raise to tighten the mask."}
 addUserKnob {7 range_max l "Range Max" t "Clip the hottest facing angles."}
 range_max 1
 addUserKnob {26 divider5 l "" +STARTLINE T " "}
 addUserKnob {6 clamp_negatives l "Clamp Negatives" t "Back-facing surfaces read as 0.\nDisable for full -1 to 1 range." +STARTLINE}
 clamp_negatives true
 addUserKnob {6 input_signed l "Input is Signed (-1 to 1)" t "Enable if normals are in -1 to 1 range.\nDisable if 0 to 1 range." +STARTLINE}
 input_signed true
 addUserKnob {26 divider6 l "" +STARTLINE T " "}
 addUserKnob {26 info l "" +STARTLINE T "<font size='1' color='#666'>Compositing Academy | Normal direction masking</font>"}
}
 Input {
  inputs 0
  name normals
  label Normals
  xpos 0
  ypos -300
 }
 NoOp {
  name DirCompute
  xpos 0
  ypos -220
  addUserKnob {20 User}
  addUserKnob {7 rad_x}
  rad_x {{"parent.rotate.x / 360.0 * (2 * 3.14159265359)"}}
  addUserKnob {7 rad_y}
  rad_y {{"parent.rotate.y / 360.0 * (2 * 3.14159265359)"}}
  addUserKnob {7 dir_x}
  dir_x {{"parent.dir_mode == 0 ? sin(rad_y) * cos(rad_x) : parent.sampled_normal.r"}}
  addUserKnob {7 dir_y}
  dir_y {{"parent.dir_mode == 0 ? -sin(rad_x) : parent.sampled_normal.g"}}
  addUserKnob {7 dir_z}
  dir_z {{"parent.dir_mode == 0 ? cos(rad_y) * cos(rad_x) : parent.sampled_normal.b"}}
 }
 BlinkScript {
  recompileCount 2
  ProgramGroup 1
  KernelDescription "3 \"NormalMask\" iterate pixelWise ce6369c49451e335a931353ef4ecd4753acbe6cc2a05a2bcbbe48621be7663ff 2 \"normals\" Read Point \"dst\" Write Point 8 \"dir_x\" Float 1 AAAAAA== \"dir_y\" Float 1 AAAAAA== \"dir_z\" Float 1 AACAPw== \"input_signed\" Bool 1 AQ== \"clamp_neg\" Bool 1 AQ== \"softness\" Float 1 AACAPw== \"range_min\" Float 1 AAAAAA== \"range_max\" Float 1 AACAPw== 8 \"dir_x\" 1 1 Default \"dir_y\" 1 1 Default \"dir_z\" 1 1 Default \"input_signed\" 1 1 Default \"clamp_neg\" 1 1 Default \"softness\" 1 1 Default \"range_min\" 1 1 Default \"range_max\" 1 1 Default 0"
  EncodedSource "1 1896 "
  vectorize false
  rebuild ""
  NormalMask_dir_x {{DirCompute.dir_x}}
  NormalMask_dir_y {{DirCompute.dir_y}}
  NormalMask_dir_z {{DirCompute.dir_z}}
  NormalMask_input_signed {{parent.input_signed}}
  NormalMask_clamp_neg {{parent.clamp_negatives}}
  NormalMask_softness {{parent.softness}}
  NormalMask_range_min {{parent.range_min}}
  NormalMask_range_max {{parent.range_max}}
  rebuild_finalise ""
  name NormalMask_Blink
  selected true
  xpos -2
  ypos -155
 }
 Output {
  name Output1
  xpos 0
  ypos -60
 }
end_group
