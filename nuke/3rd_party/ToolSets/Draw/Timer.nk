set cut_paste_input [stack 0]
version 13.2 v2
push $cut_paste_input
Group {
 name Timer
 selected true
 xpos -3973
 ypos -151
 addUserKnob {20 User}
 addUserKnob {41 startframe l Startframe T Text25.startframe}
 addUserKnob {41 startsek l Startsek T Text25.startsek}
 addUserKnob {41 startmin l Startmin T Text25.startmin}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {41 font T Text25.font}
 addUserKnob {41 global_font_scale l "global font scale" T Text25.global_font_scale}
}
 Input {
  inputs 0
  name Input1
  xpos -662
  ypos -296
 }
 Text2 {
  font_size_toolbar 100
  font_width_toolbar 100
  font_height_toolbar 100
  message "\[if \{\[value min]<10\} \{return \"0\"\} \{return \"\"\}]\[value min]:\[if \{\[value sek]<10\} \{return \"0\"\} \{return \"\"\}]\[value sek]:\[if \{\[value frameNr]<10\} \{return \"0\"\} \{return \"\"\}]\[value frameNr]"
  old_message {{48 48 58 49 53 58 48 57}
    }
  old_expression_markers {{0 0 1 1 3 2 3 4 6 6 7 7}
    }
  box {0 {height x383 2160} {width} 0}
  xjustify center
  yjustify center
  transforms {{0 2}
    }
  cursor_position 173
  font {{ Arial : Bold : arialbd.ttf : 0 }}
  center {1920 1080}
  cursor_initialised true
  autofit_bbox false
  initial_cursor_position {{662.7999878 161.5}
    }
  group_animations {{0} imported: 0 selected: items: "root transform/"}
  animation_layers {{1 11 1920 1080 0 0 1 1 0 0 0 0}
    }
  name Text25
  label "\[value message]"
  selected true
  xpos -662
  ypos -240
  addUserKnob {20 User}
  addUserKnob {3 startframe l Startframe -STARTLINE}
  addUserKnob {3 startsek l Startsek}
  addUserKnob {3 startmin l Startmin}
  addUserKnob {3 frameNr l Frame}
  frameNr {{frame%fps+1+startframe}}
  addUserKnob {3 sek l Sek}
  sek {{floor(frame/fps)%60+startsek}}
  addUserKnob {3 min l Min}
  min {{floor(frame/fps/60)+startmin}}
 }
 Output {
  name Output1
  xpos -662
  ypos -145
 }
end_group
