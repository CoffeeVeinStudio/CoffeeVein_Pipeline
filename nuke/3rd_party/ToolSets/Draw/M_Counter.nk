set cut_paste_input [stack 0]
Group {
 inputs 0
 name M_Counter
 tile_color 0xc4ff00ff
 gl_color 0xb3b3b3ff
 selected true
 xpos -486
 ypos 114
 addUserKnob {20 User}
 addUserKnob {41 initNumb l "initial number" t "what number do you want your counter to start" T NoOp1.initNumb}
 addUserKnob {41 dispOn l "display ON" t "turn on and off the display of numbers, but keep the matrix the way it is" -STARTLINE T NoOp1.dispOn}
 addUserKnob {41 minus l "minus ON" t "turn on and off the minus (-) sign in front of the numbers" -STARTLINE T NoOp1.minus}
 addUserKnob {41 dig l digits t "number of digits up to 7" T NoOp1.dig}
 addUserKnob {41 randomON l random t "when selected, number will change randomly" -STARTLINE T NoOp1.randomON}
 addUserKnob {41 pace l "pace (frames)" t "in how many frames should the number increase, decrease or change - if you want it to change every frame, set it to 1" T NoOp1.pace}
 addUserKnob {41 cntDn l countdown t "turn on countdown mode" -STARTLINE T NoOp1.cntDn}
 addUserKnob {26 ""}
 addUserKnob {41 bps l "blink per sec" t "how many times per second the numbers will blink - this will work if 'blink ON'  is selected" T NoOp1.bps}
 addUserKnob {41 blkON l "blink ON" t "turn blinking on" -STARTLINE T NoOp1.blkON}
 addUserKnob {41 compFPS l "comp fps" t "frames per second of you project - all the calculation is based on that" T NoOp1.compFPS}
 addUserKnob {26 ""}
 addUserKnob {41 color t "color of the digits - it also affects the color of the matrix" T Constant1.color}
 addUserKnob {41 mix l "matrix intensity" t "the intensity of the matrix - leave it at 0 if you don't want the matrix to display" T Merge13.mix}
 addUserKnob {26 ""}
 addUserKnob {26 glow l <b>glow</b> T <b>setup</b>}
 addUserKnob {41 tint t "tint of glow" T Glow1.tint}
 addUserKnob {41 brightness t "brightness of glow" T Glow1.brightness}
 addUserKnob {41 size t "size of glow" T Glow1.size}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {26 credit l "" +STARTLINE T "M_Counter v2.0   -   Marlon Engel (c)"}
}
