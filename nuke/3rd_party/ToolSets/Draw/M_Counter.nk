 NoOp {
  inputs 0
  name NoOp1
  selected true
  xpos 3087
  ypos -499
  addUserKnob {20 User}
  addUserKnob {3 teste}
  teste {{"random(M_Counter.NoOp1.pace+(int(frame/NoOp1.pace)))*10000000 * ((-1*NoOp1.cntDn)+(1*NoOp1.cntUp))\n\n" i}}
  addUserKnob {26 ""}
  addUserKnob {3 initNumb l "initial number"}
  initNumb 1234567
  addUserKnob {6 dispOn l "display ON" -STARTLINE}
  dispOn true
  addUserKnob {3 dig l "digits (up to 7)"}
  dig 7
  addUserKnob {3 pace l "pace (frames)"}
  pace 5
  addUserKnob {6 cntDn l countdown -STARTLINE}
  addUserKnob {6 cntUp l countup -STARTLINE}
  cntUp {{"equal (NoOp1.cntDn, 0)" i}}
  addUserKnob {6 minus l "minus ON" +STARTLINE}
  addUserKnob {26 ""}
  addUserKnob {3 linear}
  linear {{"initNumb+(int(frame/NoOp1.pace) * ((-1*NoOp1.cntDn)+(1*NoOp1.cntUp)) )" i}}
  addUserKnob {6 linearON -STARTLINE}
  linearON {{"equal (NoOp1.randomON, 0)" i}}
  addUserKnob {3 random -STARTLINE}
  random {{"random(M_Counter.NoOp1.pace+(int(frame/NoOp1.pace)))*10000000 * ((-1*NoOp1.cntDn)+(1*NoOp1.cntUp))\n\n" i}}
  addUserKnob {6 randomON l random -STARTLINE}
  addUserKnob {3 dispNumb l "display number"}
  dispNumb {{(NoOp1.linear*NoOp1.linearON)+(NoOp1.random*NoOp1.randomON) i 7}}
  addUserKnob {3 U}
  U {{"abs(int((NoOp1.dispNumb - (int(NoOp1.dispNumb/10)*10))))" i}}
  addUserKnob {3 D}
  D {{"abs(int((NoOp1.dispNumb - (int(NoOp1.dispNumb/100)*100))/10))" i}}
  addUserKnob {3 C}
  C {{"abs(int((NoOp1.dispNumb - (int(NoOp1.dispNumb/1000)*1000))/100))" i}}
  addUserKnob {3 UM}
  UM {{"abs(int((NoOp1.dispNumb - (int(NoOp1.dispNumb/10000)*10000))/1000))" i}}
  addUserKnob {3 DM}
  DM {{"abs(int((NoOp1.dispNumb - (int(NoOp1.dispNumb/100000)*100000))/10000))" i}}
  addUserKnob {3 CM}
  CM {{"abs(int((NoOp1.dispNumb - (int(NoOp1.dispNumb/1000000)*1000000))/100000))" i}}
  addUserKnob {3 MM}
  MM {{abs(int(NoOp1.dispNumb/1000000)) i}}
  addUserKnob {26 ""}
  addUserKnob {3 bps l "blink per sec"}
  bps 1
  addUserKnob {6 blkON l "blink ON" -STARTLINE}
  addUserKnob {3 blkswt l "blink switch" -STARTLINE}
  blkswt {{"inrange (((frame)-(int((frame)/(int(NoOp1.compFPS/NoOp1.bps)))*(int(NoOp1.compFPS/NoOp1.bps)))),1,int((int(NoOp1.compFPS/NoOp1.bps))/2))" i}}
  addUserKnob {3 compFPS l "comp fps"}
  compFPS 24
 }
