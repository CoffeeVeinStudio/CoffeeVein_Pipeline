#! /Applications/Nuke11.2v3/Nuke11.2v3.app/Contents/MacOS/libnuke-11.2.3.dylib -nx
version 11.2 v3
Group {
name BetterKeyer
 note_font Verdana
 addUserKnob {20 RGB t "Adjust setting for the RGB channels of your comp"}
 addUserKnob {41 screenColour l "Screen Colour" t "Increase the value that matches your screen type. Do NOT use this to pull a key." T Keylight1.screenColour}
 addUserKnob {41 screenGain l "Screen Gain" T Keylight1.screenGain}
 addUserKnob {41 screenBalance l "Screen Balance" T Keylight1.screenBalance}
 addUserKnob {41 alphaBias l "Alpha Bias" T Keylight1.alphaBias}
 addUserKnob {26 _2 l "" +STARTLINE}
 addUserKnob {26 ColorCorrect t "Use these to grade your RGB channels for a better result" -STARTLINE T ""}
 addUserKnob {41 saturation T ColorCorrect1.saturation}
 addUserKnob {41 contrast T ColorCorrect1.contrast}
 addUserKnob {41 gamma T ColorCorrect1.gamma}
 addUserKnob {41 gain T ColorCorrect1.gain}
 addUserKnob {41 offset T ColorCorrect1.offset}
 addUserKnob {20 Alpha t "Menu for adjusting the Alpha of your comp"}
 addUserKnob {41 screen_type l IBKColor_Screen_Type t "Set to your screen color" T IBKColourV3_1.screen_type}
 addUserKnob {41 _1 l IBKGizmo_Screen_Type t "Set to your screen color" T IBKGizmoV3_1.st}
 addUserKnob {41 Erode t "Increase until your FG Alpha is completely eroded" T IBKColourV3_1.erode}
 addUserKnob {41 PatchBlack l "patch black" t "Increase until your FG is gone and you have a clean screen" T IBKColourV3_1.multi}
 addUserKnob {26 ""}
 addUserKnob {41 off l darks T IBKColourV3_1.off}
 addUserKnob {41 mult l lights T IBKColourV3_1.mult}
 addUserKnob {41 red_weight l "red weight" T IBKGizmoV3_1.red_weight}
 addUserKnob {41 blue_green_weight l "blue/green weight" T IBKGizmoV3_1.blue_green_weight}
 addUserKnob {26 ""}
 addUserKnob {26 AlphaRefinement l "Alpha Refinement" t "Use these tools to refine your Alpha for a better result" T ""}
 addUserKnob {41 blackpoint t "Adjust this to refine your Alpha" T Grade1.blackpoint}
 addUserKnob {41 whitepoint t "Adjust this to refine your Alpha" T Grade1.whitepoint}
 addUserKnob {41 EdgeBlurFilter l "EdgeBlur Filter" t "Use this to change your filter type on the EdgeBlur" T EdgeBlur1.filter}
 addUserKnob {41 EdgeBlurSize l "EdgeBlur Size" t "Use this to soften the edge of your Alpha" T EdgeBlur1.size}
 addUserKnob {41 FilterErodeType l "FilterErode Type" t "Use this to set you filter type on the erode" T FilterErode1.filter}
 addUserKnob {41 FilterErodeSize l "FilterErode Size" t "Use this to refine your Alpha" T FilterErode1.size}
}
 Input {
  inputs 0
  name Input1
  xpos 269
  ypos 93
 }
 Dot {
  name Dot1
  xpos 303
  ypos 133
 }
set N3ce187c0 [stack 0]
 Dot {
  name Dot2
  xpos 150
  ypos 133
 }
 IBKColourV3 {
  name IBKColourV3_1
  xpos 116
  ypos 194
  Size 1
 }
push $N3ce187c0
 IBKGizmoV3 {
  inputs 2
  name IBKGizmoV3_1
  selected false
  xpos 269
  ypos 194
 }
 Grade {
  channels alpha
  name Grade1
  xpos 269
  ypos 232
 }
 FilterErode {
  size 0
  name FilterErode1
  xpos 269
  ypos 284
 }
 EdgeBlur {
  size 0
  tint {1.106000066 0.8599999547 1.034000039}
  name EdgeBlur1
  xpos 269
  ypos 338
 }
push $N3ce187c0
 Dot {
  name Dot3
  xpos 492
  ypos 133
 }
 OFXuk.co.thefoundry.keylight.keylight_v201 {
  show "Final Result"
  unPreMultiply false
  screenColour 0
  screenGain 1
  screenBalance 0.5
  alphaBias 0.5
  despillBias {0.5 0.5 0.5}
  gangBiases true
  preBlur 0
  "Screen Matte" 0
  screenClipMin 0
  screenClipMax 1
  screenClipRollback 0
  screenGrowShrink 0
  screenSoftness 0
  screenDespotBlack 0
  screenDespotWhite 0
  screenReplaceMethod "Soft Colour"
  screenReplaceColour {0.5 0.5 0.5}
  Tuning 0
  midPoint 0.5
  lowGain 1
  midGain 1
  highGain 1
  "Inside Mask" 0
  sourceAlphaHandling Ignore
  insideReplaceMethod "Soft Colour"
  insideReplaceColour {0.5 0.5 0.5}
  Crops 0
  SourceXMethod Colour
  SourceYMethod Colour
  SourceEdgeColour 0
  SourceCropL 0
  SourceCropR 1
  SourceCropB 0
  SourceCropT 1
  balanceSet false
  insideComponent None
  outsideComponent None
  cacheBreaker true
  name Keylight1
  xpos 458
  ypos 186
 }
 ColorCorrect {
  name ColorCorrect1
  xpos 458
  ypos 248
 }
 Copy {
  inputs 2
  from0 rgba.alpha
  to0 rgba.alpha
  name Copy1
  xpos 458
  ypos 338
 }
 Premult {
  name Premult1
  xpos 458
  ypos 384
 }
 Output {
  name Output1
  xpos 458
  ypos 424
 }
end_group
