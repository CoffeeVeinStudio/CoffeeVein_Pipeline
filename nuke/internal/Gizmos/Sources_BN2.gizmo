 addUserKnob {22 scriptHelper_button l "import scriptHelper" T "imported_scripthelper = nuke.nodePaste(\"//fs/data/_pipeline/_bin/nuke/_tools/studio/tools/scriptHelper.nk\")\n\nfor node in nuke.allNodes(\"BackdropNode\"):\n    if node.knob(\"scripsetupBackdrop\"):\n        xPos = int(node.xpos()+ 100)\n        yPos = int(node.ypos()+ 100)\n        print (xPos)\n        print (yPos)\n        nuke.zoom(.9,\[xPos,yPos])\n\n        imported_scripthelper.setXYpos(xPos,yPos)" +STARTLINE}
}
