 addUserKnob {22 getCam l "Get Camera" T "import nuke\nimport os\nimport paths\n\nrootPath = paths.get_rootpath()\nproject = paths.get_project()\nsequence = paths.get_sequence()\nshot = paths.get_shot()\n\nshotFolder = sequence + \"_\" + shot\n\nversionPath = rootPath + project + \"/vfx/_publish/camera/\" + shotFolder + \"/standard/\"\n\n\ndef chooseCam():\n    versionNames = os.listdir(versionPath)\n    versionNamesString = \" \".join(versionNames)\n\n    panel = nuke.Panel(\"Pick Version\")\n    panel.addEnumerationPulldown(\"version\", versionNamesString)\n    confirm = panel.show()\n    # Cancel if user clicks Cancel\n    if confirm == 0:\n        return\n\n    camVersion = panel.value(\"version\")\n    camVersionPath = versionPath + camVersion\n\n    fileNames = os.listdir(camVersionPath)\n    fileNamesString = \" \".join(fileNames)\n\n\n    panel = nuke.Panel(\"Pick File\")\n    panel.addEnumerationPulldown(\"file\", fileNamesString)\n    confirm = panel.show()\n \n    # Cancel if user clicks Cancel\n    if confirm == 0:\n        return\n\n    camFile = panel.value(\"file\")\n    camFilePath = camVersionPath + \"/\" + camFile\n    nuke.thisNode().knob(\"file\").setValue(camFilePath)\n    #nuke.thisNode().knob(\"frame_rate\").setValue(nuke.root().knob('fps').value())\n    read_file = nuke.thisNode().knob(\"read_from_file\")\n\n    if read_file.value() == False:\n        read_file.setValue(True)\n    else:\n        nuke.thisNode().knob(\"reload\").execute()\n\n\nif os.path.exists(versionPath) == False:\n    nuke.message(\"Path does not exist: \" + str(versionPath))\nelse:\n    chooseCam()" +STARTLINE}
}
