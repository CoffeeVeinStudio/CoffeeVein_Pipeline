 addUserKnob {22 test l "transcode ref panel" -STARTLINE +INVISIBLE T "import os\nimport subprocess\nimport tkinter as tk\nfrom tkinter import filedialog, messagebox, Menu\nfrom tkinter import ttk\nfrom tkinterdnd2 import DND_FILES, TkinterDnD\n\n\nclass VideoTranscoderApp:\n    def __init__(self, root, ffmpeg_path, ffprobe_path):\n        self.root = root\n        self.root.title(\"Video to Jpeg Transcoder\")\n        \n        self.ffmpeg_path = ffmpeg_path\n    \n        self.ffprobe_path = ffprobe_path\n\n\n\n        self.context_menu = Menu(root, tearoff=0)\n        self.context_menu.add_command(label=\"Open File Location\", command=self.open_file_location)\n\n\n        self.frame = tk.Frame(root)\n        self.frame.pack(padx=10, pady=10)\n        \n        self.buttons_frame = tk.Frame(self.frame)\n        self.buttons_frame.pack(side=tk.TOP)\n        \n        self.add_button = tk.Button(self.buttons_frame, text=\"Add Files\", command=self.add_files)\n        self.add_button.pack(side=tk.LEFT)\n        \n        self.load_sequence_button = tk.Button(self.buttons_frame, text=\"Load in sequence _references\", command=self.load_sequence)\n        self.load_sequence_button.pack(side=tk.LEFT)\n        \n        self.transcode_button = tk.Button(self.buttons_frame, text=\"Transcode\", command=self.transcode_selected)\n        self.transcode_button.pack(side=tk.LEFT)\n        \n        self.transcode_all_button = tk.Button(self.buttons_frame, text=\"Transcode All\", command=self.transcode_all)\n        self.transcode_all_button.pack(side=tk.LEFT)\n        \n        self.remove_button = tk.Button(self.buttons_frame, text=\"Remove Selected\", command=self.remove_selected)\n        self.remove_button.pack(side=tk.LEFT)\n        \n        self.file_list_label = tk.Label(self.frame, text=\"Input files\")\n        self.file_list_label.pack()\n        \n        self.file_list = tk.Listbox(self.frame, selectmode=tk.MULTIPLE, width=126, height=20)\n        self.file_list.pack(fill=tk.BOTH, expand=True)\n        self.file_list.bind(\"<Button-3>\", self.show_context_menu)\n\n\n        self.completed_list_label = tk.Label(self.frame, text=\"Completed\")\n        self.completed_list_label.pack()\n        \n        self.completed_list = tk.Listbox(self.frame, width=126, height=20)\n        self.completed_list.pack(fill=tk.BOTH, expand=True)\n        self.completed_list.bind(\"<Button-3>\", self.show_context_menu)\n        \n        self.progress_label = tk.Label(self.frame, text=\"Progress: 0/0\")\n        self.progress_label.pack()\n        \n        self.quit_button = tk.Button(self.frame, text=\"Quit\", command=root.quit)\n        self.quit_button.pack(side=tk.LEFT, anchor=tk.SW, padx=10, pady=10)  # Placed at bottom-left corner\n        \n        self.root.geometry(\"800x800\")  # Adjust window size as needed\n        \n        \n        \n\n\n\n\n        # Enable drag-and-drop\n        self.file_list.drop_target_register(DND_FILES)\n        self.file_list.dnd_bind('<<Drop>>', self.handle_drop)\n        \n        self.total_files = 0\n        self.completed_files = 0\n        \n        self.transcoding_popup = None\n        self.transcoding_process = None\n        self.transcoding_cancelled = False\n\n\n    def show_context_menu(self, event):\n        self.context_menu.post(event.x_root, event.y_root)\n        self.current_listbox = event.widget\n        self.current_selection = self.current_listbox.nearest(event.y)\n\n\n    def open_file_location(self):\n        if self.current_listbox and self.current_selection >= 0:\n            selected_file = self.current_listbox.get(self.current_selection)\n            if selected_file:\n                #file_folder = os.path.dirname(selected_file)\n                subprocess.Popen(\[\"explorer\", \"/select,\", os.path.normpath(selected_file)])\n    \n\n\n\n        \n\n\n    def add_files(self):\n        files = filedialog.askopenfilenames(filetypes=\[\n            (\"Video Files\", \"*.mp4 *.avi *.mov\"),\n            (\"All Files\", \"*.*\")\n        ])\n        for file in files:\n            self.file_list.insert(tk.END, file)\n            self.total_files += 1\n            self.update_progress_label()\n\n\n        \n    def load_sequence(self):\n        seq_folder = filedialog.askdirectory(title=\"Select Sequence Folder\")\n        if not seq_folder:\n            return\n        \n        for root, dirs, _ in os.walk(seq_folder):\n            for dir_name in dirs:\n                ref_folder = os.path.join(root, dir_name, \"_references\")\n                if os.path.exists(ref_folder):\n                    mp4_files = \[file for file in os.listdir(ref_folder) if file.lower().endswith(\".mp4\")]\n                    for mp4_file in mp4_files:\n                        input_file = os.path.join(ref_folder, mp4_file)\n                        self.file_list.insert(tk.END, input_file)\n                        self.total_files += 1\n                        self.update_progress_label()\n        \n    def transcode_selected(self):\n        selected_files = self.file_list.curselection()\n        if not selected_files:\n            messagebox.showinfo(\"Error\", \"Please select at least one file.\")\n            return\n        \n        self.transcoding_popup = tk.Toplevel(self.root)\n        self.transcoding_popup.title(\"Transcoding Progress\")\n        self.transcoding_popup.geometry(\"300x100\")\n        \n        self.progress_label_popup = tk.Label(self.transcoding_popup, text=\"Progress: 0/0\")\n        self.progress_label_popup.pack(pady=10)\n        \n        self.progress_bar = ttk.Progressbar(self.transcoding_popup, orient=\"horizontal\", length=200, mode=\"determinate\")\n        self.progress_bar.pack()\n        \n        self.cancel_button = tk.Button(self.transcoding_popup, text=\"Cancel\", command=self.cancel_transcoding)\n        self.cancel_button.pack(pady=10)\n        \n        self.transcoding_popup.transient(self.root)\n        self.transcoding_popup.grab_set()\n        \n        for idx in selected_files:\n            if self.transcoding_cancelled:\n                break\n            file = self.file_list.get(idx)\n            if self.is_long_file(file):\n                if not self.confirm_long_file(file):\n                    continue\n            self.transcode_to_jpeg(file)\n            self.completed_list.insert(tk.END, file)\n            self.file_list.delete(idx)\n            self.completed_files += 1\n            self.update_progress_label_popup()\n        \n        self.transcoding_popup.destroy()\n        self.update_progress_label()\n        messagebox.showinfo(\"Finished\", \"Transcoding complete.\")\n        \n    def transcode_all(self):\n        files = list(self.file_list.get(0, tk.END))\n        \n        self.transcoding_popup = tk.Toplevel(self.root)\n        self.transcoding_popup.title(\"Transcoding Progress\")\n        self.transcoding_popup.geometry(\"300x100\")\n        \n        self.progress_label_popup = tk.Label(self.transcoding_popup, text=\"Progress: 0/0\")\n        self.progress_label_popup.pack(pady=10)\n        \n        self.progress_bar = ttk.Progressbar(self.transcoding_popup, orient=\"horizontal\", length=200, mode=\"determinate\")\n        self.progress_bar.pack()\n        \n        self.cancel_button = tk.Button(self.transcoding_popup, text=\"Cancel\", command=self.cancel_transcoding)\n        self.cancel_button.pack(pady=10)\n        \n        self.transcoding_popup.transient(self.root)\n        self.transcoding_popup.grab_set()\n        \n        for file in files:\n            if self.transcoding_cancelled:\n                break\n            if self.is_long_file(file):\n                if not self.confirm_long_file(file):\n                    continue\n            self.transcode_to_jpeg(file)\n            self.completed_list.insert(tk.END, file)\n            self.completed_files += 1\n            self.update_progress_label_popup()\n        \n        self.transcoding_popup.destroy()\n        self.file_list.delete(0, tk.END)\n        self.update_progress_label()\n        messagebox.showinfo(\"Finished\", \"Transcoding all files complete.\")\n        \n    def transcode_to_jpeg(self, input_file):\n        try:\n            base_name = os.path.splitext(os.path.basename(input_file))\[0]\n            input_folder = os.path.dirname(input_file)\n            output_folder = os.path.join(input_folder, f\"\{base_name\}_jpeg\")\n            \n            if not os.path.exists(output_folder):\n                os.makedirs(output_folder)\n            \n            output_pattern = os.path.join(output_folder, f\"\{base_name\}.%04d.jpeg\")\n            \n            ffmpeg_command = \[\n                self.ffmpeg_path,\n                \"-i\", input_file,\n                \"-q:v\", \"2\",\n                \"-y\",\n                output_pattern\n            ]\n            \n            self.transcoding_process = subprocess.Popen(ffmpeg_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n            self.transcoding_process.communicate()\n            self.transcoding_process.wait()\n            \n        except subprocess.CalledProcessError as e:\n            print(f\"Error transcoding \{input_file\}: \{e.stderr.decode('utf-8').strip()\}\")\n            \n    def is_long_file(self, input_file):\n        try:\n            ffprobe_command = \[\n                self.ffprobe_path,\n                \"-v\", \"error\",\n                \"-i\", input_file,\n                \"-count_frames\",\n                \"-select_streams\", \"v:0\",\n                \"-show_entries\", \"stream=nb_read_frames\",\n                \"-print_format\", \"default=noprint_wrappers=1:nokey=1\"\n            ]\n\n\n            process = subprocess.Popen(ffprobe_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n            out, err = process.communicate()\n\n\n            if err:\n                print(f\"Error getting frame count for \{input_file\}: \{err.decode('utf-8').strip()\}\")\n                return False\n\n\n            frame_count = int(out.decode('utf-8'))\n            return frame_count > 1500\n        \n        except subprocess.CalledProcessError as e:\n            print(f\"Error getting frame count for \{input_file\}: \{e.stderr.decode('utf-8').strip()\}\")\n            return False\n        \n    def confirm_long_file(self, input_file):\n        return messagebox.askyesno(\"Confirm\", f\"\{input_file\} has more than 1500 frames. Are you sure you want to proceed?\")\n    \n    def handle_drop(self, event):\n        files = event.data\n        for file in files:\n            if file.lower().endswith(\".mp4\"):\n                self.file_list.insert(tk.END, file)\n                self.total_files += 1\n                self.update_progress_label()\n        \n    def remove_selected(self):\n        selected_files = self.file_list.curselection()\n        for idx in reversed(selected_files):\n            self.file_list.delete(idx)\n            self.total_files -= 1\n            if idx < self.completed_files:\n                self.completed_files -= 1\n        self.update_progress_label()\n        \n    def cancel_transcoding(self):\n        if self.transcoding_process is not None:\n            self.transcoding_process.terminate()\n        self.transcoding_cancelled = True\n        \n    def update_progress_label(self):\n        progress_text = f\"Progress: \{self.completed_files\}/\{self.total_files\}\"\n        self.progress_label.config(text=progress_text)\n        \n    def update_progress_label_popup(self):\n        progress_text = f\"Progress: \{self.completed_files\}/\{self.total_files\}\"\n        self.progress_label_popup.config(text=progress_text)\n        progress_percentage = (self.completed_files / self.total_files) * 100\n        self.progress_bar\[\"value\"] = progress_percentage\n        self.transcoding_popup.update()\n\n\ndef main():\n    root = TkinterDnD.Tk()\n    ffmpeg_path = '//fs/data/_pipeline/_bin/ffmpeg/4.2.0/ffmpeg.exe'\n    ffprobe_path = '//fs/data/_pipeline/_bin/ffmpeg/4.2.0/ffprobe.exe'\n    app = VideoTranscoderApp(root, ffmpeg_path, ffprobe_path)\n    root.mainloop()\n\n\n\nmain()\n\n\n\n\n"}
