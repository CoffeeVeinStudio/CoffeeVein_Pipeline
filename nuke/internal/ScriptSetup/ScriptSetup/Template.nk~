 addUserKnob {22 createCompWrite l Comp -STARTLINE T "this = nuke.thisNode()\n\ncomp_dot_found = False\n\nfor node in nuke.allNodes():\n    node.setSelected(False)\n\n\ndef find_dot_node(dot_label):\n\n    for node in nuke.allNodes(\"Dot\"):\n        if node\[\"label\"].getValue() == dot_label:\n            return node\n    # Return None if no node was found.\n    return None\n\n\ndef create_comp_write_node():\n        \n        connection_node = find_dot_node(\"comp write\")\n        if connection_node == None:\n            connection_node = this\n        \n        connection_node.setSelected(True)\n           \n        #Create writenode\n        newWrite = nodegraph.create_custom_writenode()\n        newWrite\[\"type\"].setValue(\"comp\")\n        \n        #colorspace\n        if not this.knob(\"write_colorspace_string\").value() == \"\":\n            newWrite\[\"colorspace\"].setValue(this.knob(\"write_colorspace_string\").value())\n        else:\n            newWrite\[\"colorspace\"].setValue(this.knob(\"colorspaceString\").value())  \n              \n        if this.knob(\"all_metadata\").value() == True:\n            newWrite\[\"metadata\"].setValue(\"all metadata\")\n\n        newWrite\[\"packetsize\"].setValue(8)\n        newWrite\[\"keepversions\"].setValue(5)\n        \n        \n        \n        #Compression\n        if not this.knob(\"compression_string\").value() == \"\":\n            newWrite\[\"compression\"].setValue(this.knob(\"compression_string\").value())\n\n\n        #Custom name\n        if this.knob(\"cname_enable\").value() == True:\n            #Look through dropdown menu for a match\n            running = True\n            while running:\n                for cname_option in newWrite.knob(\"cname_option\").values():\n                    if cname_option == this.knob(\"custom_name\").value():\n                        print (\"found:    \" + cname_option)\n                        newWrite.knob(\"cname_option\").setValue(cname_option)\n                        this.knob(\"custom_name\").setValue(cname_option)\n                        running = False\n                    if not nuke.thisNode().knob(\"custom_name\").value() == \"\":\n                        newWrite.knob(\"cname_option\").setValue(this.knob(\"custom_name\").value())\n                        running = False\n                    else:\n                        running = False\n\n        #Comment\n        comment_string = this.knob(\"write_comment_string\").value()\n        if not comment_string == \"\":\n            newWrite\[\"comments\"].setValue(comment_string)        \n\n        # version and frame digits\n        try:\n            newWrite\[\"version_digits\"].setValue(int(this.knob(\"version_digits\").value()))\n            newWrite\[\"frame_digits\"].setValue(int(this.knob(\"frame_digits\").value()))\n        except:\n            print(\"Error: Could not set value for 'version_digits' and/or 'frame_digits' knobs.\")\n            \n        \n        # preview settings\n        \n        previewKnobs = \[\n        \"project_name\",\n        \"preview_codec\",\n        \"preview_slate\",\n        \"preview_format\",\n        \"LUT_colorspaceIn\",\n        \"LUT_colorspaceOut\",\n        \"preview_colorspaceOut\",\n        \"preview_fps\",\n        \"preview_resize\",\n        \"preview_aspect\",\n        \"preview_borders\",\n        \"preview_addtimecode_node\"\n        ]\n                \n        for knob in previewKnobs:\n            try:\n                knobvalue = this.knob(knob).value()\n                if not knobvalue == None:\n                    newWrite.knob(knob).setValue(knobvalue)\n            except:\n                print(f\"Error: Could not set value for the \{knob\} knob.\")\n        \n        #if not ACES, temp solution for \"preview_colorspaceOut\"\n        try:\n            if this.knob(\"preview_colorspaceOut\"):\n                if not nukesession.get_colorManagement() == 'ACES':\n                    if \"Output - sRGB\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"sRGB\")\n                    elif \"Output - Rec.709\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"rec709\")\n                \n                else:\n                    newWrite.knob(\"preview_colorspaceOut\").setValue(this.knob(\"preview_colorspaceOut\").value())\n        except:\n            print(\"Could not set value for a preview_colorspaceOut knob\")\n        \n        #Hide if box is checked\n        if this\[\"hide_in_properties_bin\"]:\n            if this\[\"hide_in_properties_bin\"].value():\n                newWrite.hideControlPanel()\n        \n\ncreate_comp_write_node()"}
