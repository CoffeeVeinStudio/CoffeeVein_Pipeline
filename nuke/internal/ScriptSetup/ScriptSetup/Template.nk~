 addUserKnob {22 importscriptHelper l "Import settings" t "Imports \"scriptHelper\" settings if it's been published at some point." -STARTLINE T "from os.path import exists\n\nif nuke.usingOcio():\n    settingsPath = paths.get_vfx_dir()+ \"_pipeline/nuke/scriptHelperSettings/aces_scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\nelse:\n    settingsPath = paths.get_vfx_dir()+ \"_pipeline/nuke/scriptHelperSettings/scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\n\nthis = nuke.thisNode()\nimported = None\n\n# Deselect all\nfor node in nuke.allNodes():\n    node.setSelected(False)\nthis.setSelected(True)\n\ntry:\n    if exists(settingsPath):\n\n        imported = nuke.nodePaste(settingsPath)\n        if this.knob(\"replace_this_node\").value() == True:\n            xPos = this\['xpos'].value()\n            yPos = this\['ypos'].value()\n            imported.setXYpos(xPos,yPos)\n\n        #-----------------------------------------------------------------------#\n        \n        #importing viewerProcess String\n        try:\n            importVp = imported\[\"viewerProcessString\"].getValue()\n            print (f\"Imported viewerProcessString\{importVp\}\")\n            this\[\"viewerProcessString\"].setValue(importVp)\n        except:\n            print (\"viewerProcessString knob did not work, skipping this knob\")\n            pass\n        \n        \n        #-----------------------------------------------------------------------#\n        \n        #importing custom viewer\n        try:\n            import_custom_viewerProcess_enabled = imported\[\"custom_viewerProcess_enabled\"].getValue()\n            print (\"Custom Viewer:  \", import_custom_viewerProcess_enabled)\n            this\[\"custom_viewerProcess_enabled\"].setValue(import_custom_viewerProcess_enabled)\n            # If enable custom viewer, we disable regular viewer process\n            if custom_viewerProcess_enabled.value() == True:\n                this\[\"viewerprocess_enable\"].setValue(False)\n        except:\n            print (\"Error when importing value from 'custom_viewerProcess_enabled', might be an old scriptHelper\")\n        \n        #-----------------------------------------------------------------------#\n        try:\n            importCs = (imported\[\"colorspaceString\"].getValue())\n            print (importCs)\n            this\[\"colorspaceString\"].setValue(importCs)\n        except:\n            print (\"Error when importing 'colorspaceString'\")\n        #-----------------------------------------------------------------------#\n        \n        #importing reference startframe\n        try:\n            import_ref_startframe = imported.knob(\"ref_startframe\").getValue()\n            print (\"Start frame:  \", import_ref_startframe)\n            this\[\"ref_startframe\"].setValue(import_ref_startframe)\n        except:\n            print (\"ref_startframe knob does not exist, please upgrade your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n        #importing reference startframe\n        try:\n            import_ref_ignore_mp4_boolean = imported.knob(\"ignore_mp4_boolean\").getValue()\n            print (\"Ignoring mp4 files:  \", import_ref_ignore_mp4_boolean)\n            this\[\"ignore_mp4_boolean\"].setValue(import_ref_ignore_mp4_boolean)\n        except:\n            print (\"ignore_mp4_boolean knob does not exist, please upgrade your scriptHelper\")\n            pass\n                    \n        \n        #-----------------------------------------------------------------------#\n        \n        #importing compression string\n        try:\n            importCompression = imported.knob(\"compression_string\").getValue()\n            print (importCompression + \"  compression\")\n            this\[\"compression_string\"].setValue(importCompression)\n        except:\n            print (\"Compression knob does not exist, please upgrade your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n        \n        #importing Write Metadata setting\n        try:\n            importMetaBoolean = imported.knob(\"all_metadata\").value()\n            print (\"Export all metadata?  \" + str(importMetaBoolean))\n            this\[\"all_metadata\"].setValue(importMetaBoolean)\n        except:\n            print (\"Metadata knob does not exist, please update your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n            \n        #importing custom_name\n        try:\n            import_cname_enableBoolean = imported.knob(\"cname_enable\").value()\n            this\[\"cname_enable\"].setValue(import_cname_enableBoolean)\n            \n            #import_proj_codeBoolean = imported.knob(\"proj_code\").value()\n            #this\[\"proj_code\"].setValue(import_proj_codeBoolean)\n            \n            import_custom_name = imported.knob(\"custom_name\").value()\n            print (\"Importing custom_name:  \" + str(import_custom_name))\n            this\[\"custom_name\"].setValue(import_custom_name)\n        except:\n            print (\"custom_name knob does not exist, please update your scriptHelper\")\n            pass\n        \n        #-----------------------------------------------------------------------#\n            \n        #Output colorspace\n        try:\n            import_write_colorspace = imported.knob(\"write_colorspace_string\").value()\n            this\[\"write_colorspace_string\"].setValue(import_write_colorspace)\n            if import_write_colorspace == \"\":\n                print (f\"Importedd 'write_colorspace_string' knob are empty, colorspace will be same as '_plate':  \{str(importCs)\}\")\n            print (f\"Importing write_colorspace_string:  \{str(import_write_colorspace)\}\")\n        except:\n            nuke.print(\"write_colorspace_string knob does not exist, please update your scriptHelper\")\n            pass\n        \n        \n        try:\n            import_version_digits = imported.knob(\"version_digits\").value()\n            this\[\"version_digits\"].setValue(import_version_digits)\n            print (\"Importing version_digits:  \" + str(import_version_digits))\n        except:\n            nuke.print(\"version_digits knob does not exist, please update your scriptHelper\")\n            pass\n            \n        try:\n            import_frame_digits = imported.knob(\"frame_digits\").value()\n            this\[\"frame_digits\"].setValue(import_frame_digits)\n            print (\"Importing frame_digits:  \" + str(import_frame_digits))\n        except:\n            nuke.print(\"frame_digits knob does not exist, please update your scriptHelper\")\n            pass        \n        #-----------------------------------------------------------------------#\n        \n        #Output comment string\n        try:\n            import_write_comment_string = imported.knob(\"write_comment_string\").value()\n            this\[\"write_comment_string\"].setValue(import_write_comment_string)\n            print (\"Importing write_colorspace_string:  \" + str(import_write_comment_string))\n        except:\n            nuke.print(\"write_comment_string knob does not exist, please update your scriptHelper\")\n            pass\n\n        # preview settings\n\n        previewKnobs = \[\n        \"project_name\",\n        \"preview_codec\",\n        \"preview_slate\",\n        \"preview_format\",\n        \"LUT_colorspaceIn\",\n        \"LUT_colorspaceOut\",\n        \"preview_colorspaceOut\",\n        \"preview_fps\",\n        \"preview_resize\",\n        \"preview_aspect\",\n        \"preview_borders\",\n        \"preview_addtimecode_node\"\n        ]\n        \n        \n        \n        for knob in previewKnobs:\n            try:\n                this\[knob].setValue(imported.knob(knob).value())\n            except:\n                print(f\"Error: Could not get value for the \{knob\} knob.\")\n        #-----------------------------------------------------------------------#\n        \n        try:\n            import_convert_version_enable = imported.knob(\"convert_version_enable\").value()\n            this\[\"convert_version_enable\"].setValue(import_convert_version_enable)\n            print (\"Converting number of versions digits to 4?  \" + str(import_convert_version_enable))\n        except:\n            nuke.print(\"convert_version knob does not exist, might need to create a new scriptHelper node, transfer the settings and publish\")\n            pass\n        \n        #Output metadata keys\n        try:\n            imported_knob_values = \{\}\n            \n            # filter the String_Knob objects based on their names\n            imported_string_knobs = \[knob for knob in imported.knobs().values() if knob.Class() == \"EvalString_Knob\" and knob.name().startswith(\"key\")]\n            \n            for knob in imported_string_knobs:\n                imported_knob_values\[knob.name()] = imported\[knob.name()].value()\n            \n            # Transfer the knob values to the target node\n            try:\n                for knob, value in imported_knob_values.items():\n                    if knob in this.knobs():\n                        this\[knob].setValue(value)\n            except:\n                nuke.error(\"Could not copy over metadata knobs values\")\n                pass\n          \n        except:\n            print (\"Error: something happend when transferring the metadata keys values\")\n            \n        #-----------------------------------------------------------------------#\n            \n        \n    else:\n        ask = nuke.ask(\"Unable to find a scriptHelper in\" + settingsPath + \", would you like to create one?\")\n        if ask:\n            this\[\"publishScript\"].execute()\n            nuke.message(\"I have published a script as:  \" + settingsPath )\nexcept:\n    pass\n    \ntry:\n    #Deleting imported node, goodbye\n    if this.knob(\"replace_this_node\").value() == True:\n        nuke.delete(this)\n    else:\n        if imported != None:\n            nuke.delete(imported)\n            print(\"Deleted imported scriptHelperSettings node\")\n        pass\nexcept:\n    print(\"There's no imported node to delete\")"}
 addUserKnob {22 publishScript l "Publish settings" t "Only do this if you know that you have the correct settings." -STARTLINE T "# import modules\nimport shutil\nfrom os.path import exists\nimport os\nimport sys\nfrom datetime import datetime\n\n# Get time \nnow = datetime.now() # current date and time\nnow_format = now.strftime(\"%Y%m%d_%H%M%S\") #This gives YYYYMMDD_HHMMSS in string format. fx. 20221018_092433 \n\n\n\n# Define folders\nget_scripthelp_folder = paths.get_vfx_dir() + \"_pipeline/nuke/scriptHelperSettings/\"\n\n# if ACES\nif nuke.usingOcio():\n    settings_path = get_scripthelp_folder + \"aces_scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\nelse:\n    settings_path = get_scripthelp_folder + \"scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\n    \nbackup_path = get_scripthelp_folder + \"backup/\"\n\nbackup_filepath = backup_path + now_format + \"_scriptHelperSettings_\" + paths.get_projectname() + \".nk\"\n\n\nif not exists(get_scripthelp_folder):\n    os.makedirs(get_scripthelp_folder)\n\n\nif not exists(backup_path):\n    os.makedirs(backup_path)\n\n\ntry:\n    # Ask if settingsfile exist and ask permission\n    if exists(settings_path):\n        #Raise flag\n        ask = nuke.ask(\"Warning!  \" + settings_path + \"  already exists, would you like to replace it?\")\n        if ask:\n            # Backup file\n            src_dir = settings_path\n            dst_dir = backup_filepath\n            shutil.copy2(src_dir, dst_dir)\n            \n            \n            for node in nuke.allNodes():\n                node.setSelected(False)\n            nuke.thisNode().setSelected(True)\n            nuke.nodeCopy(settings_path)\n            print (\"Yes\")\n        else:\n            # You are not allowed to write over, exiting.\n            sys.exit()\n            \n# Redundant code?\nexcept:\n    pass\n\n\n# Only select the settings script and copy it to the settings-folder\ntry:\n    for node in nuke.selectedNodes():\n        node.setSelected(False)\n    nuke.thisNode().setSelected(True)\n    nuke.nodeCopy(settings_path)\n\nexcept:\n    nuke.message(\"Unable to publish settings\")\n"}
