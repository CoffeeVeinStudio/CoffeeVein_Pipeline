its\").setVisible(True)\n\nif parent_knob.name() == \"movCodec\":\n    node.knob(\"proresProfile\").setVisible(False)\n    node.knob(\"h265Profile\").setVisible(False)\n    node.knob(\"pngProfile\").setVisible(False)\n\n    match parent_knob.value():\n        case 'Apple ProRes':\n            node.knob(\"proresProfile\").setVisible(True)\n        case 'H.264':\n            node.knob(\"h265Profile\").setVisible(True)\n        case 'PNG':\n            node.knob(\"pngProfile\").setVisible(True)\n\nif parent_knob.name() == \"rootFolder\":\n    directories = os.listdir(node.knob(\"rootFolder\").getValue())\n    projects = \{\} \n    projectslist =\[]\n    for  p in directories:\n        pSplit=p.split('_')\n        try:\n            int(pSplit\[0])\n        except:\n            continue\n        else:\n            projects\[p]=int(pSplit\[0])\n    projects=dict(sorted(projects.items(), key=lambda x:x\[1],reverse = True))\n    for p in projects:    projectslist.append(p)\n    node.knob(\"Project\").setValues(projectslist)\n"
