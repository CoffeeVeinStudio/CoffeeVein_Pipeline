 addUserKnob {22 getRef l "Import Reference" t "Looking in \"_references\" and importing as readnodes." -STARTLINE T "\n\n\"\"\"\nfor node in nuke.allNodes():\n    if node.Class() == \"Dot\":\n        if node\[\"label\"].getValue() == \"offline\":\n            node.setSelected(True)\n            xPos = node.xpos()\n            yPos = node.ypos()\n\n            #Create readnodes\n            refdir = paths.get_vfx_dir() + paths.get_sequence()+ '/' + paths.get_shot() + '/_references/'\n\n            refdirList = nuke.getFileNameList(refdir)#\[0]\n            for refname in refdirList:\n                \n                if refname.endswith(\".gif\"):\n                    refdirList.remove(refname)\n            \n            for refname in refdirList:                \n                fullrefname = refdir + refname\n\n    \n                newread = nuke.createNode(\"Read\", inpanel = False)\n                newread\[\"file\"].fromUserText(fullrefname)\n                newread\[\"before\"].setValue(\"black\")\n                newread\[\"after\"].setValue(\"black\")\n                \n                newread.setXYpos(xPos - 34, yPos - 110 )\n                #Colorspace according to ocio settings\n                if \"aces\" in ocio_config:\n                    newread\[\"colorspace\"].setValue(\"Output - Rec.709\")\n                else:\n                    newread\[\"colorspace\"].setValue(\"rec709\")\n    \n                if refname == refdirList\[0]:\n                    node.setInput(0,newread)\n                    # Get startframe\n\n                else:\n                    xPos += 100\n                    newread.setXYpos(xPos, yPos - 110)\n            node.setSelected(False)\n            \n            \"\"\"\n\n\nimport paths\nimport os\nimport re\n\n\n\n    \ndef get_all_directories(path):\n    \n    folders = \[path]\n    slashconvert_folders = \[]\n    \n    for dirpath, dirnames, filenames in os.walk(path):\n        for dirname in dirnames:  \n            folders.append(os.path.join(dirpath, dirname))\n     \n    for dir in folders:\n        slashconvert_folders.append(paths.slashconvert(dir))\n    \n    version_pattern = re.compile(r\"/v\\d+\$\")\n    version_folders = \[folder for folder in slashconvert_folders if version_pattern.search(folder)]\n    sorted_folders = sorted(version_folders, key=lambda x: int(x.split(\"/\")\[-1]\[1:]))\n    \n    latest_version = \"\"\n    latest_folders = \[]\n    \n    #reverse sorted\n    #sorted_folders = sorted(sorted_folders, reverse=True)\n\n    for folder in sorted(sorted_folders, reverse=True):\n        version = folder.split(\"/\")\[-1]\[1:]\n        if version > latest_version:\n            latest_version = version\n            latest_folders.append(folder)\n\n     \n    all_folders = list(set(slashconvert_folders) - set(version_folders)) + latest_folders\n    \n    return all_folders\n\ndef import_mp4_check(item):\n    \n    if item.endswith(\".mp4\") == True:\n        if nuke.thisNode().knob(\"ignore_mp4_boolean\").getValue() == True:\n            return False\n        else:\n            return True\n    else:\n        return True\n    \ndef create_ref_readnodes(label, xPos, yPos, first):\n    # create paths\n    refpath = paths.get_vfx_dir() + paths.get_sequence()+ '/' + paths.get_shot() + '/_references/'\n    # get all folders\n    for folder in get_all_directories(refpath):\n        #folder = paths.slashconvert(folder)\n        print (\"create reference readnode:  \" + folder)\n        # Get items in folders\n        for item in nuke.getFileNameList(folder):\n            if \".\" in item:\n                if item.endswith(\".gif\") == False and item.endswith(\".aaf\") == False:\n                    # Check if we want to import mp4 files or not.\n                    if import_mp4_check(item):\n                        \n                        label = folder.split(\"_references/\")\[-1].replace(\"/\", \"_\")\n                        #print (label)\n                        \n                        # Set fullplatename and make sure we dont get \"reference//\"\n                        if folder == refpath:\n                            fullplatename = folder + item\n                        else:\n                            fullplatename = folder + \"/\" + item\n                        \n                        # Creating new readnodes\n                        newread = nuke.createNode(\"Read\", inpanel = False)\n                        newread\[\"file\"].fromUserText(fullplatename)\n                        \n                        #Colorspace according to ocio settings\n                        if \"aces\" in ocio_config:\n                            newread\[\"colorspace\"].setValue(\"Output - Rec.709\")\n                        else:\n                            newread\[\"colorspace\"].setValue(\"rec709\")\n                        # Connecting the first detected plate into the Plate01 input,\n                        \n                        if first:\n                            node.setInput(0, newread)\n                            print(\"First is:  \" + str(first))\n                            first = False\n                            yPos -= 110\n                            newread.setXYpos(xPos - 34, yPos)\n                            \n                        # Other plates will be located next to it.\n                        else:\n                            xPos += 175\n                            newread.setXYpos(xPos, yPos)\n                \n                        newread.knob(\"label\").setValue(label)\n                    \n                        newread.setSelected(False)\n            \"\"\"\n            try:                    \n            except:\n                print(\"Resulted in an error:  \" + str(item))\n            \"\"\"\n\n\n\n#######     Main     ##########\n\nthis = nuke.thisNode()\n\nocio_config = nuke.Root()\[\"OCIO_config\"].value()\n\n# Deselect allNodes\nfor node in nuke.allNodes():\n    node.setSelected(False)\n\n\nref_dot_exist = False\n\nfor node in nuke.allNodes(\"Dot\"):\n    if node\[\"label\"].getValue() == \"offline\":\n        ref_dot_exist = True\n        xPos = node.xpos()\n        yPos = node.ypos()\n        label = \"\"\n        first = True\n        node.setSelected(True)\n        create_ref_readnodes(label, xPos, yPos, first)\n        \nif not ref_dot_exist:\n        node = this\n        xPos = node.xpos()\n        yPos = node.ypos()\n        label = \"\"\n        first = False\n        node.setSelected(True)\n        create_ref_readnodes(label, xPos, yPos, first)\n        \n\n#Change startnode\n\nif nuke.thisNode()\[\"startframe_enable\"]:\n\n    ref_startframe = nuke.thisNode()\[\"ref_startframe\"].value()\n    for g_node in nuke.allNodes(\"Group\"):# temp fix, would like to only change connected nodes.\n        if \"TimecodeCalc\" in g_node.name():\n            g_node.knob(\"startframe\").setValue(ref_startframe)\n\n    #depNode = node.dependent()\[0]\n    #if \"TimecodeCalc\" in depNode.name():\n        #depNode.knob(\"startframe\").setValue(ref_startframe)\nelse:\n    print (\"Did not update startframe of reference, since it's disabled\")\n    pass\n\n"}
