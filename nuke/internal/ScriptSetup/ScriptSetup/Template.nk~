 addUserKnob {22 convert_version l "Convert version digits" t "Converting fx v003 to v0003;\nIf v001 and v002 are in the script, they will be moved to the \"scripts/backup\" folder." -STARTLINE T "import os\nimport shutil\nimport nuke\nimport re\nimport paths\n\n\ndef save_script_with_four_digits():\n    # Get the current script path\n    script_path = nuke.root().name()\n    \n    # Check if the script has a valid name\n    if not script_path:\n        nuke.message(\"Please save the script before running this script.\")\n        return\n\n    # Get the script directory and name without extension\n    script_dir, script_name = os.path.split(script_path)\n    script_name, _ = os.path.splitext(script_name)\n\n    # Extract the version number from the current script name\n\n    if re.match(r\".*_v\\d\{3\}\$\", script_name):\n        #print(script_name)\n        # Generate the new script name with four digits\n        \n        script_name_split = re.split(r'_v(\\d\{3\})', script_name)\n        script_name_before = script_name_split\[0]\n        script_version = script_name_split\[1]\n        script_name_after = script_name_split\[-1]\n        \n        if script_version.isdigit():\n            script_version_padded = script_version.zfill(4)\n        else:\n            return nuke.message(\"Error while extracting the version number, make sure your scripts name have a version number, examples: 'example_script_v001.nk'\")\n\n    \n    \n        new_script_path = f\"\{script_dir\}/\{script_name_before\}_v\{script_version_padded\}\{script_name_after\}.nk\"\n    \n        # Backup\n        nuke.scriptSaveAs(f\"\{script_dir\}/\{script_name\}.nk_backup\")    \n        \n        # Save the script with the new name\n        nuke.scriptSaveAs(new_script_path)\n\n        return nuke.message(f\"Script saved as: \{new_script_path\}, since the knob 'convert_version' was executed\")\n    else:\n        return nuke.message(\"Script name does not match the expected format when trying to convert it.\")\n        \ndef backup_3_digits_versions():\n    script_path = nuke.root().name()\n    # Get the script directory and name without extension\n    script_dir, script_name = os.path.split(script_path)\n    script_name, _ = os.path.splitext(script_name)\n    backup_folder = f\"\{script_dir\}/backup/\"\n\n    if not os.path.exists(backup_folder):\n        os.mkdir(backup_folder)\n    # Extract the version number from the current script name\n\n\n    script_name_split = re.split(r'_v(\\d\{3\})', script_name)\n    script_name_before = script_name_split\[0]\n\n    list_of_scripts = os.listdir(script_dir)\n    print(\"Before: \"+ script_name_before)\n\n    #print(script_name_before)\n    for file in list_of_scripts:\n        #print(file)\n        if file.startswith(script_name_before):\n            \n            \n            script_name = re.split('.nk', file)\[0]\n            #print(script_name)\n            \n            script_name_split = re.split(f\"\{script_name_before\}_v\",script_name)\[-1]\n            #print(script_name_split)\n            if script_name_split.isdigit() and len(script_name_split) == 3:\n                #print(script_name_split)\n                file_from = f\"\{script_dir\}/\{file\}\"\n                file_to = f\"\{backup_folder\}\{file\}\"\n                print(f\"fr: \{file_from\}\")\n                print(f\"to: \{file_to\}\")\n                shutil.move(file_from,file_to)\n        \n\n        \n\nsave_script_with_four_digits()\nbackup_3_digits_versions()"}
