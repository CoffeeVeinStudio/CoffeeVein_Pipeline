igits' knobs.\")\n            \n        \n        # preview settings\n        \n        previewKnobs = \[\n        \"project_name\",\n        \"preview_codec\",\n        \"preview_slate\",\n        \"preview_format\",\n        \"LUT_colorspaceIn\",\n        \"LUT_colorspaceOut\",\n        \"preview_colorspaceOut\",\n        \"preview_fps\",\n        \"preview_resize\",\n        \"preview_aspect\",\n        \"preview_borders\",\n        \"preview_addtimecode_node\"\n        ]\n                \n                \n        for knob in previewKnobs:\n            try:\n                knobvalue = this.knob(knob).value()\n                if not knobvalue == None:\n                    newWrite.knob(knob).setValue(knobvalue)\n            except:\n                print(f\"Error: Could not set value for the \{knob\} knob.\")\n        \n        #if not ACES, temp solution for \"preview_colorspaceOut\"\n        try:\n            if this.knob(\"preview_colorspaceOut\"):\n                if not nukesession.get_colorManagement() == 'ACES':\n                    if \"Output - sRGB\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"sRGB\")\n                    elif \"Output - Rec.709\" == this.knob(\"preview_colorspaceOut\").value():\n                        newWrite.knob(\"preview_colorspaceOut\").setValue(\"rec709\")\n                \n                else:\n                    newWrite.knob(\"preview_colorspaceOut\").setValue(this.knob(\"preview_colorspaceOut\").value())\n        except:\n            print(\"Could not set value for a preview_colorspaceOut knob\")\n            \n        #Hide if box is checked\n        if this\[\"hide_in_properties_bin\"]:\n            if this\[\"hide_in_properties_bin\"].value():\n                newWrite.hideControlPanel()"}
