set cut_paste_input [stack 0]
version 13.0 v2
push $cut_paste_input
NoOp {
name Extract_grade_aov1
selected true
xpos -3758
ypos 9124
addUserKnob {20 User}
addUserKnob {22 execute_extract l "Extract Grade AOV:s" t "Select one or more readnodes and press the button" T "import nuke\nimport nukescripts\n\n\n# Function to show a custom dialog with checkboxes for layers\ndef show_layer_dialog(layers):\n    panel = nuke.Panel(\"Select Layers for Grade_AOV\")\n    panel.setWidth(350)  # Adjust the width of the panel\n    for layer in layers:\n        panel.addBooleanCheckBox(layer, True)\n    result = panel.show()\n\n\n    if result:\n        selected_layers = \[layer for layer in layers if panel.value(layer)]\n        return selected_layers\n    return \[]\n\n\n# Function to create a Shuffle2 node\ndef create_shuffle_node(node, layer):\n    shuffle_node = nuke.createNode(\"Shuffle2\", inpanel = False)\n    shuffle_node.setInput(0, node)\n    shuffle_node\[\"in1\"].setValue(layer)\n    shuffle_node.setXpos(node.xpos() - 150)\n    shuffle_node.setYpos(node.ypos())\n    shuffle_node.setSelected(False)  # Deselect the Shuffle2 node\n    return shuffle_node\n\ndef create_text_node(node, layer):\n    text_node = nuke.createNode(\"Text2\",inpanel = False)\n    text_node.setInput(0, node)\n    text_node.setName(\"input_shuffle_channel\")\n    text_node\[\"box\"].setExpression(\"(input.width  / 20)\",0)\n    text_node\[\"box\"].setExpression(\"(input.height / 20)\",1)\n    text_node\[\"box\"].setExpression(\"input.width - (input.width / 20)\",2)\n    text_node\[\"box\"].setExpression(\"input.height - (input.height / 20)\",3)\n    text_node\[\"message\"].setValue(layer)\n    #text_node\[\"message\"].setValue(\"\[value input.input.in1]\")\n    text_node.setXpos(node.xpos())\n    text_node.setYpos(node.ypos() + 40)\n    text_node.setSelected(False)  # Deselect the Shuffle2 node\n    return text_node\n\ndef create_keep_node(node):\n    keep_node = nuke.createNode(\"Remove\", inpanel = False)\n    keep_node\[\"operation\"].setValue(\"keep\")\n    keep_node\[\"channels\"].setValue(\"rgba\")\n    keep_node.setInput(0, node)\n    keep_node.setName(\"Keep\")\n    keep_node.setXpos(node.xpos())\n    keep_node.setYpos(node.ypos() + 40)\n    keep_node.setSelected(False)\n    return keep_node\n\n# Get the currently selected nodes\nread_nodes = nuke.selectedNodes()\nscript_path = \"//fs/data/_pipeline/_bin/nuke/_tools/studio/tools/Grade_AOV.nk\"\n\n\nfor read_node in read_nodes:\n    if read_node.Class() == \"Read\":\n        # Get the list of layers in the Read node\n        layers = \[]\n\n\n        for chan in read_node.channels():\n            # Extract the base layer name\n            base_layer = chan.split('.')\[0]\n            if base_layer not in layers:\n                layers.append(base_layer)\n\n\n        # Filter layers that start with \"LIGHT_\"\n        common_start = \"\"\n        common_layers = \[layer for layer in layers if layer.startswith(common_start)]\n\n\n        if common_layers:\n            selected_layers = show_layer_dialog(common_layers)\n\n\n            if selected_layers:\n                print(f\"Selected Layers: \{', '.join(selected_layers)\}\")\n\n\n                last_node = read_node\n\n\n                for layer in selected_layers:\n                    \n\n\n                    try:\n                        \n                        # Path to the script you want to paste\n                        grade_aov_node = nuke.nodePaste(script_path)\n                        grade_aov_node\[\"in\"].setValue(layer)\n\n\n                        # Specify a position for the node instead of autoplace\n                        grade_aov_node.setXpos(last_node.xpos())\n                        grade_aov_node.setYpos(last_node.ypos() + 150)\n\n                        grade_aov_node.setInput(0,last_node)\n                        \n                        # Create a Shuffle2 node and connect it to the grade_aov_node\n                        shuffle_node = create_shuffle_node(grade_aov_node, layer)\n                        remove_node = create_keep_node(shuffle_node)\n                        text_node = create_text_node(remove_node, layer)\n\n\n\n\n\n\n                        last_node.setSelected(False)\n                        last_node = grade_aov_node\n                    except Exception as e:\n                        print(f\"Error pasting Grade_AOV node for layer \{layer\}: \{e\}\")\n\n\n\n            else:\n                print(\"No layers selected for Grade_AOV.\")\n\n\n        else:\n            print(f\"No channels with a common starting name '\{common_start\}' found in \{read_node.name()\}.\")\n\n\n    else:\n        print(\"Please select a Read node.\")\n\n" +STARTLINE}
}
