Write {
 file_type exr
 first_part rgba
 colorspace rec709
 create_directories true
 first {{"\[value \[topnode].first]"}}
 last {{"\[value \[topnode].last]"}}
 use_limit true
 checkHashOnRead false
 version 12
 ocioColorspace scene_linear
 display default
 view sRGB
 name Write2
 xpos -61
 ypos 26
 addUserKnob {20 TIK}
 addUserKnob {22 Publish l "Publish (Render)" t "Render and publish the script." T "from tik_manager4.ui import main\n\nn = nuke.thisNode()\nnuke.Root()\[\"first_frame\"].setValue(int(nuke.tcl(\"value \[topnode %s].first\" % n.name())))\nnuke.Root()\[\"last_frame\"].setValue(int(nuke.tcl(\"value \[topnode %s].last\" % n.name())))\n\n\ntui = main.launch(dcc='Nuke', dont_show=True)\ntui.on_publish_scene()" +STARTLINE}
 addUserKnob {22 SetRenderName l "Set Render Name" T "name = nuke.thisNode()\['RenderName'].getValue()\nversion = nuke.Root()\['name'].getValue().split(\".\")\[0].split(\"_\")\[-1]\nnuke.thisNode()\['name'].setValue(f\"\{name\}_\{version\}\")" +STARTLINE}
 addUserKnob {1 RenderName l " Render Name " t "The name of the rendered file" -STARTLINE}
 RenderName _DN
 addUserKnob {22 AfterRender l "After Render" T "from tik_manager4.ui import main\ntui = main.launch(dcc='Nuke', dont_show=True)\ntui.on_new_version()\n\nnuke.thisNode()\['SetRenderName'].execute()" +STARTLINE}
 addUserKnob {22 python_button +INVISIBLE T "nuke.thisNode()\[\"AfterRender\"].execute()" +STARTLINE}
}
NoOp {
 inputs 0
 name NoOp1
 xpos 162
 ypos -161
 hide_input true
 addUserKnob {20 User}
 addUserKnob {22 SetFrameRange l "Set Frame Range" t "Set frame range from selected read node" T "node = nuke.selectedNode()\nif node.Class() != \"Read\":\n    nuke.alert(\"Select a Read Node\")\nelse:\n    nuke.Root()\[\"first_frame\"].setValue(node\[\"first\"].getValue())\n    nuke.Root()\[\"last_frame\"].setValue(node\[\"last\"].getValue())" +STARTLINE}
 addUserKnob {22 SetFormat l "Set Format" T "node = nuke.selectedNode()\nif node.Class() != \"Read\":\n    nuke.alert(\"Select a Read Node\")\nelse:\n    width = node.metadata(\"input/width\")\n    height = node.metadata(\"input/height\")\n    plateFormat = f\"\{width\} \{height\} Plate\"\n    nuke.addFormat( plateFormat )\n    nuke.Root()\['format'].setValue( \"Plate\" )" +STARTLINE}
}
